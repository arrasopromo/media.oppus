<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CRM WhatsApp — LTV</title>
  <link href="/css/style.css" rel="stylesheet" />
  <style>
    .crm{ --ink:#0f172a; --muted:#64748b; --faint:#94a3b8; --line:#e5e7eb; --bg:#f6f8fb;
      --green:#16a34a; --green-soft:#dcf8c6; --accent:#4f46e5; --in:#fff; --out:#dcf8c6;
      color:var(--ink); font-family:var(--font-family),'Inter',system-ui,-apple-system,'Segoe UI',sans-serif; }
    .crm *{ box-sizing:border-box; }
    .crm-head{ display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:14px; }
    .crm-head h1{ margin:0; font-size:1.35rem; font-weight:600; letter-spacing:-0.02em; }
    .crm-head .sub{ margin:4px 0 0; color:var(--muted); font-size:0.86rem; max-width:640px; line-height:1.5; }

    .crm-grid{ display:grid; grid-template-columns:340px 1fr; gap:14px; height:calc(100vh - 150px); min-height:460px; }
    .crm-back-btn{ display:none; border:1px solid var(--line); background:#fff; border-radius:8px; padding:6px 10px; font-weight:600; cursor:pointer; margin-right:8px; font-size:0.85rem; flex:none; }
    /* ── Mobile: alterna entre LISTA e CONVERSA (estilo WhatsApp) ── */
    @media(max-width:820px){
      .crm-grid{ grid-template-columns:1fr; height:auto; min-height:0; }
      .crm-grid > .crm-card{ height:auto; }
      .crm-threads{ max-height:none; }
      .crm-msgs{ height:calc(100vh - 240px); min-height:360px; }
      /* sem conversa aberta → mostra a lista; com conversa → esconde a lista e mostra a conversa */
      .crm.mobile-conv .crm-grid > .crm-card:first-child{ display:none; }
      .crm:not(.mobile-conv) .crm-conv{ display:none; }
      .crm.mobile-conv .crm-back-btn{ display:inline-flex; align-items:center; }
      .crm-bubble{ max-width:88%; }
    }

    .crm-card{ background:#fff; border:1px solid var(--line); border-radius:14px; box-shadow:0 1px 2px rgba(16,24,40,.04); display:flex; flex-direction:column; overflow:hidden; }

    /* Lista de conversas */
    .crm-list-tools{ padding:12px; border-bottom:1px solid var(--line); display:flex; flex-direction:column; gap:9px; }
    .crm-search{ display:flex; gap:8px; }
    .crm-search input{ flex:1; padding:9px 11px; border:1px solid #d5dbe3; border-radius:9px; font-size:0.9rem; }
    .crm-search input:focus{ outline:none; border-color:var(--accent); box-shadow:0 0 0 3px #eef2ff; }
    .crm-toggle{ display:flex; align-items:center; gap:8px; font-size:0.84rem; color:var(--muted); cursor:pointer; user-select:none; }
    .crm-toggle input{ width:16px; height:16px; accent-color:var(--accent); }
    .crm-btn{ border:1px solid #d5dbe3; border-radius:9px; padding:9px 12px; font-weight:600; cursor:pointer; background:#fff; color:var(--ink); font-size:0.86rem; }
    .crm-btn:hover{ background:#f8fafc; }
    .crm-btn.primary{ background:var(--accent); color:#fff; border-color:var(--accent); }

    .crm-threads{ overflow-y:auto; flex:1; }
    .crm-thread-item{ padding:11px 13px; border-bottom:1px solid #f1f5f9; cursor:pointer; display:flex; flex-direction:column; gap:3px; }
    .crm-thread-item:hover{ background:#f8fafc; }
    .crm-thread-item.active{ background:#eef2ff; }
    .crm-thread-top{ display:flex; align-items:center; justify-content:space-between; gap:8px; }
    .crm-thread-name{ font-weight:600; font-size:0.92rem; color:var(--ink); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .crm-thread-time{ font-size:0.72rem; color:var(--faint); flex:none; }
    .crm-thread-last{ font-size:0.82rem; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .crm-thread-meta{ display:flex; align-items:center; gap:6px; }
    .crm-pill{ font-size:0.68rem; font-weight:700; padding:1px 7px; border-radius:999px; background:#dbeafe; color:#1e40af; }
    .crm-pill.reply{ background:var(--green-soft); color:#166534; }
    .crm-empty{ text-align:center; color:var(--faint); padding:28px 16px; font-size:0.88rem; }

    /* Conversa */
    .crm-conv{ }
    .crm-conv-head{ padding:12px 16px; border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; gap:10px; }
    .crm-conv-name{ font-weight:600; font-size:1rem; }
    .crm-conv-sub{ font-size:0.8rem; color:var(--muted); margin-top:2px; }
    .crm-badge{ font-size:0.72rem; font-weight:700; padding:2px 9px; border-radius:999px; }
    .crm-badge.blocked{ background:#fee2e2; color:#991b1b; }
    .crm-badge.ok{ background:#dcfce7; color:#166534; }
    .crm-msgs{ flex:1; overflow-y:auto; padding:16px; background:#efeae2; display:flex; flex-direction:column; gap:8px; }
    .crm-bubble{ max-width:76%; padding:8px 11px; border-radius:10px; font-size:0.9rem; line-height:1.4; box-shadow:0 1px 1px rgba(0,0,0,.08); word-wrap:break-word; white-space:pre-wrap; }
    .crm-bubble.in{ align-self:flex-start; background:var(--in); border-top-left-radius:2px; }
    .crm-bubble.out{ align-self:flex-end; background:var(--out); border-top-right-radius:2px; }
    .crm-bubble .t{ display:block; font-size:0.66rem; color:#667781; text-align:right; margin-top:3px; }
    .crm-bubble.media{ padding:5px 5px 6px; }
    .crm-media-img{ max-width:230px; max-height:280px; border-radius:8px; display:block; cursor:pointer; }
    .crm-media-vid{ max-width:240px; max-height:300px; border-radius:8px; display:block; background:#000; }
    .crm-media-aud{ width:220px; display:block; }
    .crm-media-cap{ font-size:0.88rem; margin-top:4px; padding:0 5px; white-space:pre-wrap; }
    .crm-media-file{ color:#2563eb; text-decoration:none; font-size:0.9rem; padding:4px 6px; display:inline-block; }
    .crm-composer .crm-attach{ font-size:1.15rem; line-height:1; padding:6px 10px; background:#fff; border:1px solid #d5dbe3; border-radius:10px; cursor:pointer; }
    .crm-composer .crm-attach:hover{ background:#f1f5f9; }
    .crm-conv-empty{ flex:1; display:flex; align-items:center; justify-content:center; color:var(--faint); font-size:0.92rem; text-align:center; padding:24px; }
    .crm-note{ padding:9px 16px; font-size:0.76rem; color:var(--faint); border-top:1px solid var(--line); background:#fafbfc; }
    .crm-composer{ display:flex; gap:8px; padding:10px 12px; border-top:1px solid var(--line); background:#fff; }
    .crm-composer textarea{ flex:1; resize:none; padding:9px 11px; border:1px solid #d5dbe3; border-radius:10px; font-size:0.92rem; font-family:inherit; max-height:120px; line-height:1.4; }
    .crm-composer textarea:focus{ outline:none; border-color:var(--accent); box-shadow:0 0 0 3px #eef2ff; }
    .crm-composer button{ flex:none; }
    .crm-composer.disabled{ opacity:0.5; }
    .crm-composer.disabled textarea, .crm-composer.disabled button{ pointer-events:none; background:#f1f5f9; }
  </style>
</head>
<body class="painel-page">
  <%- include('partials/painel_sidebar', { page:'whatsapp-crm' }) %>
  <div class="main-content">
    <div class="crm">
      <div class="crm-head">
        <div>
          <h1>CRM WhatsApp — LTV</h1>
          <p class="sub">Conversas do número do LTV (WhatsApp oficial). Veja as respostas dos clientes. Somente leitura — o histórico começa a partir de agora (a Meta não devolve mensagens antigas).</p>
        </div>
        <button class="crm-btn primary" id="crmRefresh">↻ Atualizar</button>
      </div>

      <div class="crm-grid">
        <!-- Lista -->
        <div class="crm-card">
          <div class="crm-list-tools">
            <div class="crm-search">
              <input type="text" id="crmSearch" placeholder="Buscar por telefone, nome ou @...">
              <button class="crm-btn" id="crmSearchBtn">Buscar</button>
            </div>
            <label class="crm-toggle"><input type="checkbox" id="crmOnlyReply"> Só conversas com resposta do cliente</label>
          </div>
          <div class="crm-threads" id="crmThreads">
            <div class="crm-empty">Carregando…</div>
          </div>
        </div>

        <!-- Conversa -->
        <div class="crm-card crm-conv">
          <div class="crm-conv-head" id="crmConvHead" style="display:none;">
            <div style="display:flex; align-items:center; min-width:0;">
              <button type="button" class="crm-back-btn" id="crmBack">← Conversas</button>
              <div style="min-width:0;">
                <div class="crm-conv-name" id="crmConvName">—</div>
                <div class="crm-conv-sub" id="crmConvSub"></div>
              </div>
            </div>
            <span class="crm-badge ok" id="crmConvStatus">ativo</span>
          </div>
          <div class="crm-msgs" id="crmMsgs">
            <div class="crm-conv-empty">Selecione uma conversa à esquerda para ver as mensagens.</div>
          </div>
          <div class="crm-composer disabled" id="crmComposer">
            <button class="crm-btn crm-attach" id="crmAttachBtn" type="button" title="Enviar imagem, vídeo ou áudio">📎</button>
            <input type="file" id="crmFileInput" accept="image/*,video/*,audio/*" style="display:none">
            <textarea id="crmReplyText" placeholder="Escreva uma resposta…" rows="1"></textarea>
            <button class="crm-btn primary" id="crmSendBtn">Enviar</button>
          </div>
          <div class="crm-note" id="crmComposerNote">Selecione uma conversa para responder.</div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      var $ = function(id){ return document.getElementById(id); };
      async function api(path){ try { var r = await fetch(path, { headers:{Accept:'application/json'}, credentials:'same-origin' }); return await r.json(); } catch(_){ return { ok:false }; } }
      var esc = function(s){ return String(s==null?'':s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); };
      var nf = function(v){ return (Number(v)||0).toLocaleString('pt-BR'); };
      function fmtTime(iso){
        try { var d=new Date(iso); if(isNaN(d)) return '';
          var today=new Date(); var sameDay=d.toDateString()===today.toDateString();
          return sameDay ? d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})
                         : d.toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit'})+' '+d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
        } catch(_){ return ''; }
      }
      // Remove o rótulo [imagem]/[áudio]/[vídeo]/[documento] do texto p/ exibir só a legenda.
      function captionOf(t){ return String(t||'').replace(/^\[(imagem|áudio|audio|vídeo|video|documento|figurinha)\]\s*/i,'').trim(); }
      var current = null; // phoneKey selecionado
      var threadsCache = [];

      function renderThreads(list){
        var box = $('crmThreads');
        if (!list || !list.length){ box.innerHTML = '<div class="crm-empty">Nenhuma conversa'+($('crmOnlyReply').checked?' com resposta':'')+' ainda.</div>'; return; }
        box.innerHTML = list.map(function(t){
          var title = t.name ? esc(t.name) : (t.ig ? '@'+esc(t.ig) : esc(t.phoneE164));
          var reply = (t.inCount||0) > 0;
          var lastPrefix = (t.lastDirection==='out') ? 'Você: ' : '';
          return '<div class="crm-thread-item'+(t.phoneKey===current?' active':'')+'" data-key="'+esc(t.phoneKey)+'">'
            + '<div class="crm-thread-top"><span class="crm-thread-name">'+title+'</span><span class="crm-thread-time">'+fmtTime(t.lastAt)+'</span></div>'
            + '<div class="crm-thread-last">'+esc(lastPrefix)+esc((t.lastText||'').slice(0,60))+'</div>'
            + '<div class="crm-thread-meta">'
              + (reply?'<span class="crm-pill reply">'+nf(t.inCount)+' resp.</span>':'')
              + '<span class="crm-pill">'+esc(t.phoneE164)+'</span>'
            + '</div>'
          + '</div>';
        }).join('');
        Array.prototype.forEach.call(box.querySelectorAll('.crm-thread-item'), function(el){
          el.addEventListener('click', function(){ openThread(el.getAttribute('data-key')); });
        });
      }

      async function loadThreads(){
        var q = ($('crmSearch').value||'').trim();
        var only = $('crmOnlyReply').checked ? '1' : '0';
        var d = await api('/api/painel/whatsapp-crm/threads?withReply='+only+'&q='+encodeURIComponent(q));
        if (d && d.ok){ threadsCache = d.threads||[]; renderThreads(threadsCache); }
        else { $('crmThreads').innerHTML = '<div class="crm-empty">Falha ao carregar.</div>'; }
      }

      function renderMessages(data){
        $('crmConvHead').style.display = 'flex';
        $('crmConvName').textContent = data.name || (data.ig ? '@'+data.ig : data.phoneE164);
        var subParts = [];
        if (data.ig) subParts.push('@'+data.ig);
        subParts.push(data.phoneE164);
        $('crmConvSub').textContent = subParts.join(' · ');
        var st = $('crmConvStatus');
        if (data.blocked){ st.textContent='opt-out / bloqueado'; st.className='crm-badge blocked'; }
        else { st.textContent='ativo'; st.className='crm-badge ok'; }
        paintComposer(data);
        var box = $('crmMsgs');
        var msgs = data.messages||[];
        if (!msgs.length){ box.innerHTML = '<div class="crm-conv-empty">Sem mensagens registradas para este contato.</div>'; return; }
        box.innerHTML = msgs.map(function(m){
          var body;
          if (m.hasMedia && m.mediaUrl){
            var url = m.mediaUrl;
            var media;
            if (m.mediaKind==='image') media = '<a href="'+url+'" target="_blank" rel="noopener"><img class="crm-media-img" src="'+url+'" loading="lazy" alt="imagem"></a>';
            else if (m.mediaKind==='video') media = '<video class="crm-media-vid" controls preload="metadata" src="'+url+'"></video>';
            else if (m.mediaKind==='audio') media = '<audio class="crm-media-aud" controls preload="none" src="'+url+'"></audio>';
            else media = '<a class="crm-media-file" href="'+url+'" target="_blank" rel="noopener">📎 baixar arquivo</a>';
            var cap = captionOf(m.text);
            body = media + (cap ? '<div class="crm-media-cap">'+esc(cap)+'</div>' : '');
          } else {
            body = esc(m.text||'');
          }
          return '<div class="crm-bubble '+(m.direction==='out'?'out':'in')+(m.hasMedia?' media':'')+'">'+body+'<span class="t">'+fmtTime(m.at)+'</span></div>';
        }).join('');
        box.scrollTop = box.scrollHeight;
      }

      // ── Responder (texto livre, só na janela de 24h da Meta) ──
      var canReplyNow = false;
      function paintComposer(data){
        var comp = $('crmComposer'), note = $('crmComposerNote');
        canReplyNow = !!(data && data.canReply);
        if (!comp || !note) return;
        if (canReplyNow){
          comp.classList.remove('disabled');
          note.textContent = 'Janela de resposta aberta' + (data.hoursLeft ? (' · ' + data.hoursLeft + 'h restantes') : '') + '. A Meta cobra por conversa de atendimento.';
          note.style.color = '#059669';
        } else {
          comp.classList.add('disabled');
          if (data && data.blocked) { note.textContent = 'Cliente descadastrou (opt-out) — não dá pra enviar.'; }
          else { note.textContent = 'Fora da janela de 24h da Meta — o cliente precisa mandar uma mensagem primeiro (ou usar template). Só respondo texto livre até 24h após a última mensagem dele.'; }
          note.style.color = 'var(--faint)';
        }
      }
      async function sendReply(){
        if (!canReplyNow || !current) return;
        var ta = $('crmReplyText'); var text = (ta && ta.value || '').trim();
        if (!text) return;
        var btn = $('crmSendBtn'); if (btn) btn.disabled = true;
        try {
          var r = await fetch('/api/painel/whatsapp-crm/send', { method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, credentials:'same-origin', body: JSON.stringify({ phone: current, text: text }) });
          var d = await r.json().catch(function(){ return {ok:false}; });
          if (d && d.ok){ if (ta) ta.value=''; await openThread(current); }
          else { alert('Falha ao enviar: ' + ((d && d.message) || (d && d.error) || 'erro')); }
        } catch(_){ alert('Erro de rede ao enviar.'); }
        finally { if (btn) btn.disabled = false; }
      }
      if ($('crmSendBtn')) $('crmSendBtn').addEventListener('click', sendReply);
      if ($('crmReplyText')) $('crmReplyText').addEventListener('keydown', function(e){ if (e.key==='Enter' && !e.shiftKey){ e.preventDefault(); sendReply(); } });

      // ── Enviar MÍDIA (imagem/vídeo/áudio) — só na janela de 24h ──
      if ($('crmAttachBtn')) $('crmAttachBtn').addEventListener('click', function(){ if(!canReplyNow) return; var fi=$('crmFileInput'); if(fi){ fi.value=''; fi.click(); } });
      if ($('crmFileInput')) $('crmFileInput').addEventListener('change', async function(){
        var fi = this; var file = fi.files && fi.files[0];
        if (!file || !canReplyNow || !current){ fi.value=''; return; }
        if (file.size > 16*1024*1024){ alert('Arquivo grande demais (máx 16MB).'); fi.value=''; return; }
        var ta = $('crmReplyText'); var caption = (ta && ta.value || '').trim();
        var btn = $('crmSendBtn'), att = $('crmAttachBtn'), note = $('crmComposerNote');
        var prevNote = note ? note.textContent : '', prevColor = note ? note.style.color : '';
        if (btn) btn.disabled = true; if (att) att.disabled = true;
        if (note){ note.textContent = 'Enviando mídia…'; note.style.color = '#059669'; }
        try {
          var fd = new FormData(); fd.append('file', file); fd.append('phone', current); if (caption) fd.append('caption', caption);
          var r = await fetch('/api/painel/whatsapp-crm/send-media', { method:'POST', credentials:'same-origin', body: fd });
          var d = await r.json().catch(function(){ return {ok:false}; });
          if (d && d.ok){ if (ta) ta.value=''; await openThread(current); }
          else { alert('Falha ao enviar: ' + ((d && d.message) || (d && d.error) || 'erro')); }
        } catch(_){ alert('Erro de rede ao enviar mídia.'); }
        finally { if (btn) btn.disabled=false; if (att) att.disabled=false; if (note){ note.textContent=prevNote; note.style.color=prevColor; } fi.value=''; }
      });

      // Mobile: ao abrir uma conversa, mostra a conversa (esconde a lista). Botão "voltar".
      var crmRoot = document.querySelector('.crm');
      if ($('crmBack')) $('crmBack').addEventListener('click', function(){ if (crmRoot) crmRoot.classList.remove('mobile-conv'); });
      async function openThread(key){
        current = key;
        if (crmRoot) crmRoot.classList.add('mobile-conv');
        Array.prototype.forEach.call(document.querySelectorAll('.crm-thread-item'), function(el){
          el.classList.toggle('active', el.getAttribute('data-key')===key);
        });
        $('crmMsgs').innerHTML = '<div class="crm-conv-empty">Carregando…</div>';
        var d = await api('/api/painel/whatsapp-crm/thread?phone='+encodeURIComponent(key));
        if (d && d.ok) renderMessages(d);
        else $('crmMsgs').innerHTML = '<div class="crm-conv-empty">Falha ao carregar a conversa.</div>';
      }

      $('crmSearchBtn').addEventListener('click', loadThreads);
      $('crmSearch').addEventListener('keydown', function(e){ if(e.key==='Enter') loadThreads(); });
      $('crmOnlyReply').addEventListener('change', loadThreads);
      $('crmRefresh').addEventListener('click', function(){ loadThreads(); if(current) openThread(current); });

      loadThreads();
      // Atualização automática leve (a cada 20s): recarrega lista e a conversa aberta.
      setInterval(function(){ loadThreads(); if(current) openThread(current); }, 20000);
    })();
  </script>
</body>
</html>
