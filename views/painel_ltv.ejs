<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LTV — Reengajamento</title>
  <style>
    /* LTV: mesma folha do admin (painel-admin.css), mesma linguagem do Track do Site:
       papel frio, fios finos, números tabulares; azul-caneta só p/ seleção/destaque,
       verde/vermelho/âmbar só p/ lucro, custo/prejuízo e atenção. */
    .ltv{
      --ink:var(--tinta,#14171c); --muted:var(--grafite,#525a67); --faint:var(--lapis,#8a93a1); --line:var(--fio,rgba(20,23,28,.09)); --bg:var(--papel,#f4f5f7);
      --accent:var(--caneta,#2f5bea); --accent-soft:var(--caneta-fundo,#eef3fe); --green:var(--lucro,#127a4a); --green-soft:#e9f4ee;
      --red:var(--prejuizo,#c8352b); --red-soft:#fbeeec; --amber:var(--alerta,#b7791f); --amber-soft:#faf3e4;
      --card:var(--folha,#fff); --anelc:0 0 0 1px var(--fio,rgba(20,23,28,.09));
      max-width:1480px; margin:0 auto; color:var(--ink);
    }
    .ltv .num, .ltv .val, .ltv .n, .ltv .v{ font-variant-numeric:tabular-nums; }
    .ltv *{ box-sizing:border-box; }

    /* Header */
    .ltv-head{ display:flex; align-items:flex-start; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:20px; }
    .ltv-head h1{ margin:0; font-size:28px; font-weight:650; font-stretch:88%; letter-spacing:-.02em; }
    .ltv-head .sub{ margin:4px 0 0; color:var(--muted); font-size:14px; max-width:62ch; line-height:1.5; }
    .ltv-winbadge{ display:inline-flex; align-items:center; gap:7px; padding:6px 12px; border-radius:999px; font-size:12.5px; font-weight:600; white-space:nowrap; }
    .ltv-winbadge.open{ background:var(--green-soft); color:var(--green); }
    .ltv-winbadge.closed{ background:var(--amber-soft); color:var(--amber); }
    .ltv-winbadge .dot{ width:8px; height:8px; border-radius:50%; background:currentColor; }

    /* Grids */
    .ltv-kpis, .ltv-fin{ display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:1px; background:var(--line); border-radius:12px; overflow:hidden; box-shadow:var(--anelc); }
    .ltv-kpis{ grid-template-columns:repeat(4,minmax(0,1fr)); }
    .ltv-fin{ grid-template-columns:repeat(4,minmax(0,1fr)); margin-top:14px; }
    @media(max-width:1000px){ .ltv-kpis{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media(max-width:520px){ .ltv-kpis{ grid-template-columns:1fr; } }
    @media(max-width:900px){ .ltv-fin{ grid-template-columns:repeat(2,1fr); } }
    @media(max-width:520px){ .ltv-fin{ grid-template-columns:1fr; } }
    .ltv-cols{ display:grid; grid-template-columns:1.1fr 1fr; gap:18px; margin-top:18px; }
    .ltv-cols{ align-items:start; }
    .ltv-cols > *, .ltv-send > *{ min-width:0; }
    @media(max-width:860px){ .ltv-cols{ grid-template-columns:1fr; } }

    /* Cards */
    .ltv-card{ background:var(--card); border:0; border-radius:12px; padding:16px 18px 18px; box-shadow:var(--anelc); min-width:0; }
    .ltv-k{ background:var(--card); padding:14px 16px; min-width:0; position:relative; }
    .ltv-sec{ display:flex; align-items:baseline; gap:8px; margin:22px 0 8px; font-size:13px; font-weight:650; color:var(--ink); }
    .ltv-sec span{ font-weight:400; font-size:12px; color:var(--faint); }
    .ltv-ops{ grid-template-columns:repeat(3,minmax(0,1fr)); }
    @media(max-width:900px){ .ltv-ops{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media(max-width:520px){ .ltv-ops{ grid-template-columns:1fr; } }
    .ltv-i{ width:16px; height:16px; flex:none; border-radius:50%; border:1px solid var(--line); background:transparent; color:var(--faint); font:600 10px/14px Georgia,serif; font-style:italic; padding:0; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; }
    .ltv-i:hover, .ltv-i[aria-expanded="true"]{ color:var(--ink); border-color:var(--faint); }
    .ltv-i:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
    .ltv-pop{ position:absolute; z-index:1000; width:min(320px, calc(100vw - 32px)); background:#1d2128; color:#fff; font-size:12.5px; line-height:1.5; padding:10px 12px; border-radius:8px; box-shadow:0 8px 24px rgba(0,0,0,.18); }
    .ltv-pop::before{ content:''; position:absolute; top:-5px; left:var(--seta,24px); width:10px; height:10px; background:#1d2128; transform:rotate(45deg); }
    .ltv-k .lbl{ display:flex; align-items:center; gap:7px; font-size:12px; font-weight:500; color:var(--muted); }
    .ltv-k .dot{ display:none; }
    .ltv-k #oaDot{ display:inline-block; width:7px; height:7px; border-radius:50%; flex:none; }
    .ltv-k .val{ font-size:24px; font-weight:650; letter-spacing:-.02em; margin-top:2px; line-height:1.15; }
    .ltv-k .sub{ font-size:12px; color:var(--faint); margin-top:3px; line-height:1.45; }
    .ltv-k .val.green{ color:var(--green); } .ltv-k .val.red{ color:var(--red); } .ltv-k .val.accent{ color:var(--accent); }

    .ltv-h2{ font-size:15px; font-weight:650; margin:0 0 4px; display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
    .ltv-note{ color:var(--faint); font-size:12.5px; line-height:1.5; margin:0 0 14px; max-width:110ch; }

    /* Distribuição */
    .ltv-dist{ display:flex; flex-direction:column; gap:13px; }
    .ltv-dist .r{ display:grid; grid-template-columns:92px 1fr auto; gap:12px; align-items:center; }
    .ltv-dist .t{ font-size:13px; color:var(--ink); }
    .ltv-dist .bar{ height:8px; border-radius:4px; background:var(--vala,#eceef2); overflow:hidden; }
    .ltv-dist .bar>span{ display:block; height:100%; border-radius:4px; background:var(--accent); }
    .ltv-dist .n{ font-weight:600; font-size:13px; min-width:46px; text-align:right; white-space:nowrap; }

    /* Cupons */
    .ltv-coupons{ display:grid; grid-template-columns:repeat(auto-fill,minmax(165px,1fr)); gap:10px; }
    .ltv-coupon{ border:0; box-shadow:var(--anelc); border-radius:10px; padding:12px 13px; background:var(--card); }
    .ltv-coupon .top{ display:flex; align-items:center; justify-content:space-between; gap:8px; }
    .ltv-coupon .code{ font-weight:600; font-size:0.98rem; font-family:ui-monospace,Menlo,Consolas,monospace; }
    .ltv-coupon .pct{ font-weight:600; color:var(--accent); font-size:12px; padding:2px 8px; border-radius:999px; background:var(--accent-soft); }
    .ltv-coupon .meta{ margin-top:11px; display:grid; grid-template-columns:1fr 1fr; gap:7px 10px; }
    .ltv-coupon .k{ font-size:0.68rem; color:var(--faint); text-transform:uppercase; letter-spacing:.03em; }
    .ltv-coupon .v{ font-weight:600; font-size:0.92rem; }
    .ltv-badge{ display:inline-flex; align-items:center; gap:5px; font-size:12px; font-weight:500; padding:3px 9px; border-radius:999px; }
    .ltv-badge.ok{ background:var(--green-soft); color:var(--green); }
    .ltv-badge.off{ background:var(--red-soft); color:var(--red); }
    .ltv-badge.inf{ background:var(--vala,#eceef2); color:var(--muted); }
    .ltv-badge b{ color:var(--ink); }
    .ltv-empty{ grid-column:1/-1; text-align:center; color:var(--faint); padding:24px; border:1px dashed var(--line); border-radius:12px; font-size:0.88rem; }

    /* Envio */
    .ltv-send{ display:grid; grid-template-columns:1fr 300px; gap:18px; margin-top:20px; }
    @media(max-width:820px){ .ltv-send{ grid-template-columns:1fr; } }
    .ltv-config{ display:flex; flex-direction:column; gap:16px; }
    .ltv-field{ display:flex; flex-direction:column; gap:6px; }
    .ltv-field > label{ font-size:0.8rem; font-weight:600; color:var(--ink); }
    .ltv-field .hint{ font-size:0.74rem; color:var(--faint); font-weight:400; }
    .ltv-input, .ltv-select{ padding:8px 10px; border:0; border-radius:8px; font:inherit; font-size:13.5px; font-weight:500; color:var(--ink); background:var(--vala,#eceef2); min-width:0; }
    .ltv-input:focus, .ltv-select:focus{ outline:none; box-shadow:0 0 0 2px var(--foco,rgba(47,91,234,.35)); }
    .ltv-field-row{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    @media(max-width:520px){ .ltv-field-row{ grid-template-columns:1fr; } }

    /* Card dinâmico de disponíveis */
    .ltv-avail{ background:var(--sombra,#f8f9fb); border:0; box-shadow:var(--anelc); border-radius:12px; padding:18px; display:flex; flex-direction:column; gap:14px; }
    .ltv-avail .big{ text-align:center; }
    .ltv-avail .big .n{ font-size:44px; font-weight:650; font-stretch:88%; letter-spacing:-.03em; color:var(--ink); line-height:1; font-variant-numeric:tabular-nums; }
    .ltv-avail .big .t{ font-size:12px; color:var(--muted); font-weight:500; margin-top:6px; }
    .ltv-avail .lines{ border-top:1px solid var(--line); padding-top:12px; display:flex; flex-direction:column; gap:8px; }
    .ltv-avail .line{ display:flex; align-items:center; justify-content:space-between; font-size:0.84rem; }
    .ltv-avail .line .l{ color:var(--muted); }
    .ltv-avail .line .v{ font-weight:600; }
    .ltv-willsend{ text-align:center; font-size:0.86rem; color:var(--muted); padding:10px; background:var(--accent-soft); border-radius:10px; }
    .ltv-willsend b{ color:var(--accent); font-size:1.05rem; }

    /* Botões */
    .ltv-actions{ display:flex; gap:10px; flex-wrap:wrap; margin-top:4px; }
    .ltv-btn{ display:inline-flex; align-items:center; gap:6px; border:0; box-shadow:0 0 0 1px var(--fio-forte,rgba(20,23,28,.16)); border-radius:8px; padding:9px 14px; font:inherit; font-weight:600; cursor:pointer; background:var(--card); color:var(--ink); font-size:13px; transition:background .12s; }
    .ltv-btn:hover{ background:var(--sombra,#f8f9fb); }
    .ltv-btn:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }
    .ltv-btn:active{ transform:translateY(1px); }
    .ltv-btn:disabled{ opacity:.5; cursor:not-allowed; }
    .ltv-btn.primary{ background:var(--ink); color:#fff; box-shadow:none; }
    .ltv-btn.primary:hover{ background:#2a2f37; }
    .ltv-btn.full{ width:100%; justify-content:center; }
    .ltv-msg{ margin-top:12px; font-size:0.88rem; color:var(--muted); } .ltv-msg.err{ color:var(--red); } .ltv-msg.ok{ color:var(--green); }
    .ltv-prog{ margin-top:12px; padding:12px 15px; background:var(--sombra,#f8f9fb); box-shadow:var(--anelc); border-radius:10px; font-size:13px; }
    .ltv-switch{ display:inline-flex; align-items:center; gap:9px; font-weight:600; cursor:pointer; }

    /* Flag / toggle do envio automático */
    .ltv-flagcard{ display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap;
      padding:14px 16px; border:0; box-shadow:var(--anelc); border-radius:10px; background:var(--sombra,#f8f9fb); margin:10px 0 14px; }
    .ltv-flagcard .info .title{ font-size:14px; font-weight:650; }
    .ltv-flagcard .info .desc{ font-size:0.82rem; color:var(--muted); margin-top:3px; max-width:520px; line-height:1.5; }
    .ltv-flagcard .right{ display:flex; align-items:center; gap:12px; }
    .ltv-statepill{ font-size:0.74rem; font-weight:600; padding:3px 10px; border-radius:999px; letter-spacing:.02em; }
    .ltv-statepill.on{ background:var(--green-soft); color:var(--green); }
    .ltv-statepill.off{ background:var(--vala,#eceef2); color:var(--muted); }
    /* toggle */
    .ltv-toggle{ position:relative; width:52px; height:30px; flex:none; }
    .ltv-toggle input{ opacity:0; width:0; height:0; position:absolute; }
    .ltv-toggle .track{ position:absolute; inset:0; background:var(--borracha,#b8bec8); border-radius:999px; transition:background .18s; cursor:pointer; }
    .ltv-toggle .track::before{ content:''; position:absolute; height:24px; width:24px; left:3px; top:3px; background:#fff; border-radius:50%; transition:transform .18s; box-shadow:0 1px 3px rgba(0,0,0,.2); }
    .ltv-toggle input:checked + .track{ background:var(--green); }
    .ltv-toggle input:checked + .track::before{ transform:translateX(22px); }
    .ltv-toggle input:disabled + .track{ opacity:.5; cursor:not-allowed; }

    /* Checkboxes de tipo do envio automático */
    .d2-types{ display:grid; grid-template-columns:repeat(auto-fill,minmax(210px,1fr)); gap:8px; }
    .d2-type{ display:flex; align-items:center; gap:8px; padding:9px 12px; border:0; box-shadow:var(--anelc); border-radius:8px; background:var(--card); cursor:pointer; font-size:13px; user-select:none; }
    .d2-type:hover{ background:var(--sombra,#f8f9fb); }
    .d2-type input{ width:16px; height:16px; accent-color:var(--accent); cursor:pointer; }
    .d2-type input:checked + span{ font-weight:600; color:var(--ink); }
    /* Envios automáticos por dia: colunas (dia mais antigo à esquerda) */
    .ad-resumo{ display:flex; gap:22px; flex-wrap:wrap; font-size:12.5px; color:var(--muted); margin:0 0 12px; }
    .ad-resumo b{ color:var(--ink); font-size:15px; font-weight:650; font-variant-numeric:tabular-nums; margin-right:4px; }
    .ad-wrap{ overflow-x:auto; -webkit-overflow-scrolling:touch; padding-bottom:2px; }
    .ad-cols{ display:flex; align-items:flex-end; gap:2px; height:170px; min-width:100%; border-bottom:1px solid var(--fio-forte,rgba(20,23,28,.16)); }
    .ad-col{ flex:1 1 2px; min-width:2px; height:100%; display:flex; align-items:flex-end; position:relative; cursor:default; }
    .ad-col span{ display:block; width:100%; background:var(--accent); border-radius:2px 2px 0 0; min-height:2px; opacity:.85; }
    .ad-col:hover span{ opacity:1; background:var(--ink); }
    .ad-eixo{ display:flex; gap:2px; min-width:100%; margin-top:5px; font-size:11px; color:var(--faint); font-variant-numeric:tabular-nums; }
    .ad-eixo i{ flex:1 1 2px; min-width:2px; font-style:normal; white-space:nowrap; overflow:visible; }
    .ad-dica{ font-size:12px; color:var(--muted); margin-top:8px; min-height:1.4em; }
    .ad-dica b{ color:var(--ink); }
    @media(max-width:900px){ .ltv-fin{ grid-template-columns:repeat(2,minmax(0,1fr)); } }
    @media(max-width:520px){ .ltv-fin{ grid-template-columns:1fr; } .ltv-head h1{ font-size:24px; } .ad-cols, .ad-eixo{ gap:1px; } #ltvRefreshAll{ margin-left:0 !important; } .ltv input[type=date]{ max-width:140px; } }
  </style>
</head>
<body class="painel-page">
  <%- include('partials/painel_sidebar', {page:'ltv'}) %>
  <div class="main-content">
    <div class="ltv">
      <%
        const brl = (v) => 'R$ ' + (Number(v)||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
        const nf = (v) => (Number(v)||0).toLocaleString('pt-BR');
        const _rec = Number(recompra)||0;
        const _pct = (n) => _rec>0 ? Math.max(3, Math.round((Number(n)||0)/_rec*100)) : 0;
        // CTR sobre o TOTAL de mensagens (automático + manual), não só os contatos registrados.
        const _totalEnv = (typeof totalEnviadas !== 'undefined') ? Number(totalEnviadas)||0 : 0;
        const _ctr = _totalEnv>0 ? Math.round((Number(clicaram)||0)/_totalEnv*1000)/10 : 0;
        const _win = (typeof sendWindow!=='undefined' && sendWindow) ? sendWindow : {start:8,end:21,open:true,current:0};
        const _cap = (typeof dailyCap!=='undefined') ? Number(dailyCap) : 50;
      %>

      <!-- Header -->
      <div class="ltv-head">
        <div>
          <h1>LTV — Reengajamento</h1>
          <p class="sub">Traga de volta quem já comprou seguidores. Gere a base de recompra, configure o envio e acompanhe cliques, faturamento e cupons.</p>
        </div>
        <div class="ltv-winbadge <%= _win.open ? 'open' : 'closed' %>">
          <span class="dot"></span>
          <span>Janela <%= _win.start %>h–<%= _win.end %>h · <%= _win.open ? 'aberta' : 'fechada agora' %></span>
        </div>
      </div>

      <!-- Pedidos de bloqueio vindos de reclamação no CRM IA (aprovar/recusar lá embaixo) -->
      <a href="#blSug" id="blSugAviso" class="bl-aviso" hidden><span class="bl-aviso-n" id="blSugAvisoN">0</span><span><b>pedido(s) de bloqueio aguardando aprovação</b> — clientes que reclamaram no CRM IA WhatsApp</span><span class="bl-aviso-ir">ver e aprovar ↓</span></a>

      <!-- Filtro por período (afeta a página toda) + Atualizar (AJAX, sem reload) -->
      <%
        var _curPeriod = (typeof period !== 'undefined' && period) ? String(period) : 'all';
        var _curStart  = (typeof startDate !== 'undefined') ? String(startDate||'') : '';
        var _curEnd    = (typeof endDate   !== 'undefined') ? String(endDate||'')   : '';
        var _ltvPeriods = [['all','Tudo'],['today','Hoje'],['yesterday','Ontem'],['last3days','Últimos 3 dias'],['last7days','Últimos 7 dias'],['thismonth','Este mês'],['lastmonth','Mês passado']];
      %>
      <div class="ltv-card" style="padding:12px 16px; margin-bottom:16px; display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <span style="font-weight:600; font-size:0.82rem; color:var(--muted);">Período:</span>
        <div id="ltvPeriodBtns" style="display:flex; gap:6px; flex-wrap:wrap;">
          <% _ltvPeriods.forEach(function(x){ %>
            <button type="button" class="ltv-btn ltvPeriodBtn <%= _curPeriod===x[0] ? 'primary' : '' %>" data-period="<%= x[0] %>" style="padding:6px 12px; font-size:0.82rem;"><%= x[1] %></button>
          <% }); %>
        </div>
        <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap; min-width:0;">
          <input type="date" id="ltvStart" value="<%= _curPeriod==='custom' ? _curStart : '' %>" class="ltv-input" style="padding:6px 8px; font-size:0.82rem;">
          <span style="color:var(--faint); font-size:0.8rem;">até</span>
          <input type="date" id="ltvEnd" value="<%= _curPeriod==='custom' ? _curEnd : '' %>" class="ltv-input" style="padding:6px 8px; font-size:0.82rem;">
          <button type="button" id="ltvApplyDates" class="ltv-btn" style="padding:6px 12px; font-size:0.82rem;">Aplicar</button>
        </div>
        <button type="button" id="ltvRefreshAll" class="ltv-btn primary" style="margin-left:auto; padding:7px 16px;" title="Atualiza os números sem recarregar — mantém o envio em andamento visível">↻ Atualizar</button>
        <span id="ltvRefreshMsg" style="font-size:0.78rem; color:var(--faint);"></span>
      </div>

      <%
        var _ltvV = (typeof ltvVendas !== 'undefined' && ltvVendas) || {};
        var _ltvN0 = (Number((_ltvV.auto||{}).n)||0) + (Number((_ltvV.manual||{}).n)||0) + (Number((_ltvV.semOrigem||{}).n)||0);
        var _ltvN = _ltvN0.toLocaleString('pt-BR');
        var _ltvTot = (typeof totalEnviadas !== 'undefined') ? Number(totalEnviadas) || 0 : 0;
        var _ltvConv = (_ltvTot ? Math.round(_ltvN0 / _ltvTot * 1000) / 10 : 0).toLocaleString('pt-BR');
      %>
      <!-- 1) Resultado das mensagens: enviadas → clicaram → pagaram → faturado -->
      <div class="ltv-sec">Resultado das mensagens <span>no período escolhido</span></div>
      <div class="ltv-kpis">
        <div class="ltv-k"><div class="lbl">Mensagens de LTV enviadas<button type="button" class="ltv-i" aria-label="O que é este número" data-i="Quantas mensagens de LTV (cupom de recompra) o sistema mandou no período. Automático = o envio de 2 dias depois da compra (D+2). Manual = o botão Enviar por base. Não inclui lembretes de pagamento, recuperação nem conversas do bot.">i</button></div><div class="val" id="kTotalEnviadas"><%= nf(typeof totalEnviadas !== 'undefined' ? totalEnviadas : 0) %></div><div class="sub">automático <b id="kAutoMensagens"><%= nf(typeof autoMensagens !== 'undefined' ? autoMensagens : 0) %></b> · manual <b id="kManualMensagens"><%= nf(typeof manualMensagens !== 'undefined' ? manualMensagens : 0) %></b></div></div>
        <div class="ltv-k"><div class="lbl">Pessoas que clicaram<button type="button" class="ltv-i" aria-label="O que é este número" data-i="Quantas PESSOAS diferentes abriram o link do cupom pelo menos uma vez. O total de cliques é maior porque a mesma pessoa abre o link mais de uma vez e a prévia do link no WhatsApp também conta como clique. Use o número de pessoas.">i</button></div><div class="val" id="kClicaram"><%= nf(clicaram) %></div><div class="sub"><span id="kCtr"><%= String(_ctr).replace('.', ',') %></span>% de quem recebeu · <span id="kCliques"><%= nf(cliques) %></span> cliques no total</div></div>
        <div class="ltv-k"><div class="lbl">Pedidos pagos pelo LTV<button type="button" class="ltv-i" aria-label="O que é este número" data-i="Pedidos pagos no período usando um cupom do LTV. É a venda que a mensagem trouxe. A porcentagem é pedidos pagos ÷ mensagens enviadas.">i</button></div><div class="val green" id="kPedidosLtv"><%= _ltvN %></div><div class="sub"><span id="kConvPagos"><%= _ltvConv %></span>% das mensagens viraram compra</div></div>
        <div class="ltv-k"><div class="lbl">Faturado com o LTV<button type="button" class="ltv-i" aria-label="O que é este número" data-i="Soma do valor pago nos pedidos que usaram cupom do LTV no período.">i</button></div><div class="val green" id="kFaturado"><%= brl(faturado) %></div><div class="sub">ticket médio <span id="kTicket"><%= brl(_ltvN0 ? faturado / _ltvN0 : 0) %></span></div></div>
      </div>
      <!-- (operação fica no bloco 3, mais abaixo) -->
      <style>
        .oa-k .lbl{ position:relative; }
        .oa-toggle{ all:unset; margin-left:auto; cursor:pointer; font-size:0.72rem; font-weight:600; text-transform:none; letter-spacing:0; color:var(--accent); }
        .oa-toggle:hover{ text-decoration:underline; }
        .oa-toggle:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; border-radius:3px; }
        .oa-form{ display:flex; flex-wrap:wrap; gap:6px; margin-top:10px; padding-top:10px; border-top:1px solid var(--line); }
        .oa-form[hidden]{ display:none; }
        .oa-form .ltv-input{ flex:1 1 90px; min-width:0; padding:6px 8px; font-size:0.84rem; }
        .oa-form .ltv-btn{ padding:6px 12px; font-size:0.82rem; }
        .oa-form a{ flex-basis:100%; font-size:0.74rem; color:var(--faint); text-decoration:none; }
        .oa-form a:hover{ color:var(--accent); }
      </style>
      <script>
        (function(){
          var $ = function(id){ return document.getElementById(id); };
          var valor = $('oaValor'), info = $('oaInfo'), dot = $('oaDot'), form = $('oaForm'), toggle = $('oaToggle'), input = $('oaInput'), salvar = $('oaSalvar');
          if (!valor || !form) return;
          function usd(v){ return 'US$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
          function pinta(c){ valor.style.color = c; dot.style.background = c; }
          function abrir(sim){ form.hidden = !sim; toggle.setAttribute('aria-expanded', sim ? 'true' : 'false'); toggle.textContent = sim ? 'fechar' : 'atualizar'; if (sim) { try { input.focus(); } catch(_) {} } }
          function mostrar(d){
            if (!d || !d.ok){ valor.textContent = 'Erro'; pinta('#d97706'); info.textContent = 'não foi possível consultar'; return; }
            if (d.semCredito){ valor.textContent = 'Sem crédito'; pinta('#dc2626'); info.textContent = 'o bot não responde até recarregar'; return; }
            if (d.saldoUsd == null){
              valor.textContent = d.erro ? 'Falha no teste' : 'Com crédito'; pinta(d.erro ? '#d97706' : '#059669');
              info.textContent = d.erro ? ('erro: ' + d.erro) : 'bot respondendo · informe o saldo p/ estimar';
              return;
            }
            valor.textContent = '≈ ' + usd(d.saldoUsd); pinta(d.saldoUsd < 5 ? '#dc2626' : (d.saldoUsd < 15 ? '#d97706' : '#059669'));
            info.textContent = usd(d.saldoBaseUsd) + ' informados − ' + usd(d.gastoUsd) + ' gastos';
          }
          function carregar(){ fetch('/api/painel/openai-credito', { credentials:'same-origin' }).then(function(r){ return r.json(); }).then(mostrar).catch(function(){ mostrar(null); }); }
          function enviar(){
            var saldo = Number(input.value);
            if (input.value === '' || !(saldo >= 0)) { info.textContent = 'digite o saldo em dólar'; return; }
            salvar.disabled = true;
            fetch('/api/painel/openai-credito', { method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ saldo: saldo }) })
              .then(function(r){ return r.json(); })
              .then(function(d){ salvar.disabled = false; input.value = ''; abrir(false); mostrar(d); })
              .catch(function(){ salvar.disabled = false; mostrar(null); });
          }
          toggle.addEventListener('click', function(){ abrir(form.hidden); });
          salvar.addEventListener('click', enviar);
          input.addEventListener('keydown', function(e){ if (e.key === 'Enter') enviar(); if (e.key === 'Escape') abrir(false); });
          var refresh = $('ltvRefreshAll'); if (refresh) refresh.addEventListener('click', carregar);
          carregar();
        })();
      </script>

      <!-- Financeiro -->
      <%
