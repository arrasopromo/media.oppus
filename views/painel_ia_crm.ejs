<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CRM IA WhatsApp</title>
  <link href="/css/style.css" rel="stylesheet" />
  <style>
    * { box-sizing: border-box; }
    body { font-family: sans-serif; background: #f0f2f5; color: #111b21; margin: 0; padding: 0; }
    /* Altura real do chat: desconta o topo do painel (no celular a sidebar fica
       sticky em cima). --crm-top é medido no JS; sem isso o rodapé (campo de
       digitação) e o botão Voltar ficavam fora da tela no celular. */
    .crm { display: flex; height: calc(100vh - var(--crm-top, 0px)); height: calc(100dvh - var(--crm-top, 0px)); background: #fff; overflow: hidden; }
    /* o painel dá min-height:100vh no .main-content — aqui isso criava rolagem
       extra na página e empurrava o campo de digitação pra fora da tela. */
    .main-content { min-height: 0 !important; overflow: hidden; }
    /* Lista de conversas */
    .convs { width: 360px; min-width: 300px; border-right: 1px solid #e9edef; display: flex; flex-direction: column; background: #fff; }
    .convs-head { padding: 12px 14px; background: #f0f2f5; border-bottom: 1px solid #e9edef; display: flex; align-items: center; gap: 10px; }
    .convs-head h2 { margin: 0; font-size: 1.05rem; color: #111b21; }
    .convs-head .pill { margin-left: auto; font-size: 0.72rem; background: #25d366; color: #fff; padding: 2px 8px; border-radius: 999px; }
    .search { padding: 8px 12px; border-bottom: 1px solid #f0f2f5; }
    .search input { width: 100%; padding: 8px 12px; border: none; background: #f0f2f5; border-radius: 8px; font-size: 0.9rem; outline: none; }
    .conv-list { flex: 1; overflow-y: auto; }
    .conv { display: flex; gap: 10px; padding: 11px 14px; cursor: pointer; border-bottom: 1px solid #f5f6f6; align-items: center; }
    .conv:hover { background: #f5f6f6; }
    .conv.active { background: #e9f7ef; }
    .avatar { width: 44px; height: 44px; border-radius: 50%; background: #d1d7db; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1rem; flex-shrink: 0; }
    .conv-main { flex: 1; min-width: 0; }
    .conv-top { display: flex; justify-content: space-between; gap: 8px; }
    .conv-name { font-weight: 600; font-size: 0.92rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .conv-time { font-size: 0.7rem; color: #667781; flex-shrink: 0; }
    .conv-sub { font-size: 0.82rem; color: #667781; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
    .badge-unread { background: #25d366; color: #fff; border-radius: 999px; font-size: 0.68rem; padding: 1px 7px; margin-left: 6px; }
    .tag-bot { font-size: 0.62rem; background: #7c3aed; color: #fff; padding: 1px 5px; border-radius: 4px; margin-left: 6px; vertical-align: middle; }
    .tag-paused { font-size: 0.62rem; background: #6b7280; color: #fff; padding: 1px 5px; border-radius: 4px; margin-left: 6px; vertical-align: middle; }
    /* Guias: Aguardando | Novas | Antigas | Todas — uma linha só, rolável no celular. */
    .tabs { display:flex; gap:6px; padding:2px 10px 10px; overflow-x:auto; scrollbar-width:none; -webkit-overflow-scrolling:touch; }
    .tabs::-webkit-scrollbar { display:none; }
    .tab { flex:0 0 auto; white-space:nowrap; font-size:0.76rem; font-weight:600; padding:7px 13px; border:1px solid #dfe5ea;
      background:#fff; color:#54656f; border-radius:999px; cursor:pointer; display:inline-flex; align-items:center; gap:5px; transition:background .12s, color .12s; }
    .tab:hover { background:#f3f6f8; }
    .tab.active { background:#111b21; color:#fff; border-color:#111b21; }
    /* Aguardando resposta tem cor própria: é a fila de trabalho. */
    .tab[data-tab="pending"] { background:#fffaf0; border-color:#f3d29a; color:#b45309; }
    .tab[data-tab="pending"].active { background:#f59e0b; border-color:#f59e0b; color:#fff; }
    .tab-badge { background:#f59e0b; color:#fff; border-radius:999px; font-size:0.66rem; font-weight:800; padding:0 6px; min-width:18px; text-align:center; }
    .tab.active .tab-badge { background:#fff; color:#b45309; }
    /* Conversa importada (histórico DataCrazy): IA pausada por origem, não por atendimento. */
    .tag-legacy { font-size: 0.62rem; background: #b45309; color: #fff; padding: 1px 5px; border-radius: 4px; margin-left: 6px; vertical-align: middle; }
    /* Coluna de tempo à direita da conversa */
    .conv-side { flex-shrink:0; display:flex; flex-direction:column; align-items:flex-end; gap:2px; min-width:52px; }
    .side-elapsed { font-size:0.76rem; font-weight:700; color:#667781; }
    .side-elapsed.pend { color:#d97706; }
    .side-clock { font-size:0.68rem; color:#9aa5ab; }
    /* Conversa aguardando resposta: barra laranja à esquerda */
    .conv.pend { border-left:3px solid #f59e0b; background:#fffdf7; }
    .conv.pend:hover { background:#fff8ea; }
    .conv.pend.active { background:#e9f7ef; }
    /* Cabeçalho de grupo (aguardando / respondidas) */
    .grp { position:sticky; top:0; z-index:1; background:#eef2f5; color:#54656f; font-size:0.7rem; font-weight:800; text-transform:uppercase; letter-spacing:0.04em; padding:5px 14px; border-bottom:1px solid #e2e8ec; }
    /* Thread */
    .thread { flex: 1; display: flex; flex-direction: column; background: #efeae2; min-width: 0; }
    .thread-head { padding: 10px 16px; background: #f0f2f5; border-bottom: 1px solid #e9edef; display: flex; align-items: center; gap: 10px; }
    .thread-head .back { display: none; background: none; border: none; font-size: 1.4rem; cursor: pointer; color: #54656f; }
    .thread-head .t-name { font-weight: 600; }
    .thread-head .t-phone { font-size: 0.75rem; color: #667781; }
    .thread-head .actions { margin-left: auto; display: flex; gap: 8px; }
    .btn-bot { padding: 6px 12px; border-radius: 8px; border: 1px solid; cursor: pointer; font-size: 0.8rem; font-weight: 600; }
    .btn-bot.on { border-color: #16a34a; color: #16a34a; background: #fff; }
    .btn-bot.off { border-color: #d97706; color: #d97706; background: #fff; }
    .msgs { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 6px; }
    .b { max-width: 72%; padding: 7px 10px; border-radius: 8px; font-size: 0.9rem; line-height: 1.35; white-space: pre-wrap; word-wrap: break-word; box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); position: relative; }
    .b .meta { font-size: 0.62rem; color: #667781; margin-top: 3px; text-align: right; }
    .b.in { align-self: flex-start; background: #fff; }
    .b.out { align-self: flex-end; background: #d9fdd3; }
    .b.out.agent { background: #cfe9ff; }
    .b .who { font-size: 0.62rem; font-weight: 700; margin-bottom: 2px; }
    .b.out .who { color: #7c3aed; }
    .b.out.agent .who { color: #1d6fd8; }
    .msgs { background-color: #efeae2; background-image: radial-gradient(rgba(0,0,0,0.03) 1px, transparent 1px); background-size: 22px 22px; }
    /* mídia nos balões */
    .b .cap { margin-top: 4px; }
    .media-img, .media-sticker { max-width: 240px; max-height: 300px; border-radius: 8px; display: block; cursor: pointer; }
    .media-sticker { max-width: 130px; background: transparent; }
    .media-video { max-width: 260px; border-radius: 8px; display: block; }
    .media-audio { width: 230px; height: 38px; margin-top: 2px; }
    .media-doc { display: flex; align-items: center; gap: 8px; background: rgba(0,0,0,0.05); padding: 9px 11px; border-radius: 8px; text-decoration: none; color: inherit; min-width: 180px; }
    .media-doc .doc-ico { font-size: 1.4rem; }
    .media-doc .doc-name { flex: 1; font-size: 0.85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .media-doc .doc-dl { font-size: 0.72rem; color: #027eb5; font-weight: 600; }
    .b.media { padding: 4px; }
    .b.media .meta { padding: 0 4px 2px; }
    /* Citação dentro do balão + botão responder */
    .b { position: relative; }
    .quoted { border-left:3px solid #25d366; background:rgba(0,0,0,0.05); border-radius:5px; padding:4px 8px; margin-bottom:5px; }
    .b.in .quoted { border-left-color:#7c3aed; }
    .q-who { font-size:0.64rem; font-weight:800; color:#1d6fd8; }
    .q-txt { font-size:0.78rem; color:#54656f; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .reply-btn { position:absolute; top:2px; right:4px; opacity:0; border:none; background:transparent; cursor:pointer; font-size:0.95rem; color:#54656f; padding:0 3px; }
    .b:hover .reply-btn { opacity:0.75; }
    .reply-btn:hover { opacity:1 !important; }
    .reply-bar { display:flex; align-items:center; gap:8px; padding:7px 14px; background:#eef2f5; border-top:1px solid #e2e8ec; }
    .reply-bar .rb-body { flex:1; min-width:0; border-left:3px solid #25d366; padding-left:8px; }
    .reply-bar .rb-who { font-size:0.68rem; font-weight:800; color:#1d6fd8; }
    .reply-bar .rb-txt { font-size:0.8rem; color:#54656f; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .reply-bar button { border:none; background:transparent; font-size:1rem; cursor:pointer; color:#54656f; }
    /* composer — padrão WhatsApp: campo largo, ações como ícones redondos */
    .composer { display: flex; gap: 6px; padding: 8px 10px; background: #f0f2f5; border-top: 1px solid #e9edef; align-items: flex-end; }
    .composer textarea { flex: 1 1 auto; min-width: 0; padding: 10px 14px; border: none; border-radius: 20px; font-size: 0.95rem; outline: none;
      resize: none; font-family: inherit; line-height: 1.35; max-height: 120px; overflow-y: auto; background: #fff; }
    .icon-btn { width: 40px; height: 40px; flex: 0 0 40px; border: none; background: transparent; border-radius: 50%;
      cursor: pointer; font-size: 1.15rem; line-height: 1; color: #54656f; display: flex; align-items: center; justify-content: center; padding: 0; }
    .icon-btn:hover { background: #e2e7ea; }
    .icon-btn.rec { background: #dc2626; color: #fff; animation: pulse 1s infinite; }
    .composer #sendBtn { width: 40px; height: 40px; flex: 0 0 40px; border: none; border-radius: 50%; background: #25d366; color: #fff;
      font-size: 1.05rem; cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0; }
    .composer #sendBtn:disabled { opacity: 0.5; cursor: not-allowed; }
    @keyframes pulse { 0%,100%{opacity:1;} 50%{opacity:0.6;} }
    .upmsg { font-size: 0.75rem; color: #667781; padding: 0 16px 6px; background: #f0f2f5; min-height: 0; }
    .upmsg.err { color: #dc2626; }
    .empty { flex: 1; display: flex; align-items: center; justify-content: center; color: #667781; text-align: center; padding: 20px; }
    .hint { padding: 8px 14px; font-size: 0.72rem; color: #92400e; background: #fef3c7; }
    @media (max-width: 820px) {
      .convs { width: 100%; min-width: 0; }
      .thread { display: none; }
      .crm.show-thread .convs { display: none; }
      .crm.show-thread .thread { display: flex; }
      /* Voltar: botão de verdade, grande e sempre visível no topo da conversa. */
      .thread-head { padding: 8px 10px; gap: 8px; }
      .thread-head .back { display: inline-flex; align-items: center; justify-content: center;
        width: 38px; height: 38px; flex: 0 0 38px; border-radius: 50%; background: #fff;
        border: 1px solid #dfe5ea; font-size: 1.25rem; color: #111b21; }
      .thread-head .back:active { background: #e2e7ea; }
      .thread-head .avatar { width: 34px !important; height: 34px !important; }
      .thread-head .t-name { font-size: 0.95rem; max-width: 42vw; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .btn-bot { padding: 6px 9px; font-size: 0.72rem; }
      .b { max-width: 86%; }
      .media-img, .media-sticker, .media-video { max-width: 68vw; }
      .media-audio { width: 62vw; max-width: 240px; }
      /* Campo de digitação largo: as ações viram só ícone, como no WhatsApp. */
      .composer { padding: 7px 8px; gap: 4px; }
      .composer textarea { font-size: 16px; }   /* < 16px faz o iOS dar zoom sozinho */
      .icon-btn { width: 36px; height: 36px; flex: 0 0 36px; font-size: 1.1rem; }
      .composer #sendBtn { width: 40px; height: 40px; flex: 0 0 40px; }
      .msgs { padding: 10px 8px; }
    }
  </style>
</head>
<body>
  <%- include('partials/painel_sidebar', { page: 'ia-crm' }) %>
  <div class="main-content" style="padding:0;">
    <div class="crm" id="crm">
      <!-- Lista -->
      <div class="convs">
        <div class="convs-head">
          <h2>CRM IA WhatsApp</h2>
          <span class="pill" id="convCount">0</span>
        </div>
        <div class="search"><input type="text" id="search" placeholder="Buscar conversa..." autocomplete="off"></div>
        <!-- Uma linha de guias: fila de trabalho + separação novas/histórico importado. -->
        <div class="tabs" id="tabs">
          <button type="button" class="tab" data-tab="pending">⏳ Aguardando <span class="tab-badge" id="pendCount">0</span></button>
          <button type="button" class="tab active" data-tab="new">Novas</button>
          <button type="button" class="tab" data-tab="legacy">Antigas</button>
          <button type="button" class="tab" data-tab="all">Todas</button>
        </div>
        <div class="conv-list" id="convList"></div>
      </div>
      <!-- Thread -->
      <div class="thread" id="thread">
        <div class="empty" id="emptyThread">Selecione uma conversa à esquerda para começar.</div>
        <div id="threadInner" style="display:none; flex-direction:column; height:100%;">
          <div class="thread-head">
            <button class="back" id="backBtn">&#8592;</button>
            <div class="avatar" id="tAvatar" style="width:38px;height:38px;font-size:0.85rem;">?</div>
            <div>
              <div class="t-name" id="tName">—</div>
              <div class="t-phone" id="tPhone"></div>
            </div>
            <div class="actions">
              <button class="btn-bot on" id="botBtn">🤖 Bot ligado</button>
            </div>
          </div>
          <div class="hint" id="pausedHint" style="display:none;">⏸ IA pausada neste chat — ela NÃO responde. Só você atende. Clique em "▶ Dar Play (IA)" para a IA voltar a responder.</div>
          <div class="msgs" id="msgs"></div>
          <div id="replyBar" class="reply-bar" style="display:none;">
            <div class="rb-body"><div class="rb-who" id="rbWho"></div><div class="rb-txt" id="rbTxt"></div></div>
            <button type="button" id="rbCancel" title="Cancelar resposta">✕</button>
          </div>
          <div class="composer">
            <button type="button" class="icon-btn" id="attachBtn" title="Anexar imagem, documento ou áudio" aria-label="Anexar">📎</button>
            <input type="file" id="fileInput" accept="image/*,audio/*,video/*,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt,.zip" style="display:none">
            <textarea id="msgInput" placeholder="Mensagem" rows="1" autocomplete="off"></textarea>
            <button type="button" class="icon-btn" id="micBtn" title="Gravar áudio" aria-label="Gravar áudio">🎤</button>
            <button type="button" id="sendBtn" title="Enviar" aria-label="Enviar">➤</button>
          </div>
          <div class="upmsg" id="upMsg"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function(){
      function $(id){ return document.getElementById(id); }
      function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
      function initials(name, phone){ var n=String(name||'').trim(); if(n) return n.slice(0,2).toUpperCase(); var p=String(phone||'').replace(/\D/g,''); return p.slice(-2) || '?'; }
      function fmtTime(d){ try{ var x=new Date(d); var now=new Date(); var sameDay=x.toDateString()===now.toDateString(); return sameDay ? (('0'+x.getHours()).slice(-2)+':'+('0'+x.getMinutes()).slice(-2)) : (('0'+x.getDate()).slice(-2)+'/'+('0'+(x.getMonth()+1)).slice(-2)); }catch(_){ return ''; } }
      async function api(url, opts){ var r=await fetch(url, Object.assign({ credentials:'same-origin', headers:{'Accept':'application/json'} }, opts||{})); return await r.json().catch(function(){return null;}); }

      var state = { current: null, currentName: '', botPaused: false, convs: [], filter: '', tab: 'new', scope: 'new', answer: 'all', msgs: [], replyTo: null };

      // Cada guia é um par (escopo, respondida?). "Aguardando" é a fila de trabalho:
      // só conversas NOVAS em que a última mensagem foi do cliente.
      var TABS = {
        pending: { scope: 'new',    answer: 'pending' },
        'new':   { scope: 'new',    answer: 'all' },
        legacy:  { scope: 'legacy', answer: 'all' },
        all:     { scope: 'all',    answer: 'all' }
      };

      // A sidebar do painel fica sticky no topo no celular: sem descontar a altura
      // dela, o rodapé do chat (campo de digitação) some da tela.
      function fitHeight(){
        try{
          var sb=document.querySelector('.sidebar');
          var top=(sb && window.innerWidth<=768) ? Math.round(sb.getBoundingClientRect().height) : 0;
          document.documentElement.style.setProperty('--crm-top', top+'px');
        }catch(_){}
      }
      fitHeight();
      window.addEventListener('resize', fitHeight);
      window.addEventListener('orientationchange', function(){ setTimeout(fitHeight, 250); });

      // Tempo decorrido compacto: 6min / 22h / 3d — mostrado À DIREITA da conversa.
      function fmtElapsed(d){
        try{
          var ms=Date.now()-new Date(d).getTime(); if(!isFinite(ms)||ms<0) return '';
          var min=Math.floor(ms/60000);
          if(min<1) return 'agora';
          if(min<60) return min+'min';
          var h=Math.floor(min/60); if(h<24) return h+'h';
          var dd=Math.floor(h/24); return dd+'d';
        }catch(_){ return ''; }
      }
      function renderConvs(){
        var list=$('convList'); var q=state.filter.toLowerCase();
        var items=state.convs.filter(function(c){
          if(q && (c.name||'').toLowerCase().indexOf(q)<0 && (c.phone||'').indexOf(q)<0) return false;
          // "não respondida" = a última mensagem foi do CLIENTE (ninguém respondeu depois)
          var pendente=(c.lastDir!=='out');
          if(state.answer==='pending' && !pendente) return false;
          if(state.answer==='done' && pendente) return false;
          return true;
        });
        // Não respondidas primeiro; dentro de cada grupo, mais recente no topo.
        items.sort(function(a,b){
          var pa=(a.lastDir!=='out')?0:1, pb=(b.lastDir!=='out')?0:1;
          if(pa!==pb) return pa-pb;
          return new Date(b.lastAt||0)-new Date(a.lastAt||0);
        });
        // O badge da guia "Aguardando" é sempre a fila das conversas NOVAS,
        // independente da guia aberta (senão trocaria de número a cada aba).
        var nPend=(state.pendingNew!=null) ? state.pendingNew : state.convs.filter(function(c){ return c.lastDir!=='out'; }).length;
        $('convCount').textContent=state.convs.length;
        var badgePend=$('pendCount'); if(badgePend) badgePend.textContent=nPend;

        var html=''; var grupoAtual=null;
        items.forEach(function(c){
          var pendente=(c.lastDir!=='out');
          // Cabeçalho de grupo (só quando não está filtrando por um dos dois)
          if(state.answer==='all'){
            var g=pendente?'pend':'ok';
            if(g!==grupoAtual){
              grupoAtual=g;
              html+='<div class="grp">'+(pendente?'⏳ Aguardando resposta':'✓ Respondidas')+'</div>';
            }
          }
          var nm=c.name || ('+'+c.phone);
          var prefix=(c.lastDir==='out')?'Você: ':'';
          var tag=c.botPaused?(c.legacy?'<span class="tag-legacy" title="Conversa antiga importada — IA pausada">antiga</span>':'<span class="tag-paused">humano</span>'):'<span class="tag-bot">bot</span>';
          html+='<div class="conv'+(state.current===c.phone?' active':'')+(pendente?' pend':'')+'" data-phone="'+esc(c.phone)+'" data-name="'+esc(c.name||'')+'">'
            +'<div class="avatar">'+esc(initials(c.name,c.phone))+'</div>'
            +'<div class="conv-main">'
              +'<div class="conv-top"><span class="conv-name">'+esc(nm)+tag+'</span></div>'
              +'<div class="conv-sub">'+esc(prefix)+esc(c.lastText||'')+'</div>'
            +'</div>'
            // Coluna de tempo à DIREITA (não embaixo): decorrido + hora/data
            +'<div class="conv-side">'
              +'<div class="side-elapsed'+(pendente?' pend':'')+'">'+fmtElapsed(c.lastAt)+'</div>'
              +'<div class="side-clock">'+fmtTime(c.lastAt)+'</div>'
              +(c.unread?'<span class="badge-unread">novo</span>':'')
            +'</div>'
          +'</div>';
        });
        var vazio = (state.tab==='pending')
          ? '<div class="empty" style="height:auto;padding:28px 20px;">✅ Nenhuma conversa aguardando resposta.</div>'
          : '<div class="empty" style="height:auto;padding:24px;">Nenhuma conversa aqui.</div>';
        var novo = html || vazio;
        // O polling redesenha a lista a cada 5s. Se nada mudou, não mexe no DOM
        // (senão o scroll do usuário volta pro topo enquanto ele está rolando).
        if(novo===state._convsHtml) return;
        var topoAntes=list.scrollTop;
        list.innerHTML=novo;
        state._convsHtml=novo;
        list.scrollTop=topoAntes;   // mantém onde o usuário estava
      }

      async function loadConvs(){
        var d=await api('/api/painel/ia-crm/conversations?scope='+encodeURIComponent(state.scope));
        if(d&&d.ok){ state.convs=d.conversations||[]; if(typeof d.pendingNew==='number') state.pendingNew=d.pendingNew; renderConvs(); }
      }

      function mediaHtml(m){
        var src='/api/painel/ia-crm/media?id='+encodeURIComponent(m.mediaId||'');
        if(m.type==='image') return '<img class="media-img" src="'+src+'" onclick="window.open(this.src,\"_blank\")">';
        if(m.type==='sticker') return '<img class="media-sticker" src="'+src+'">';
        if(m.type==='audio') return '<audio class="media-audio" controls preload="none" src="'+src+'"></audio>';
        if(m.type==='video') return '<video class="media-video" controls preload="metadata" src="'+src+'"></video>';
        if(m.type==='document') return '<a class="media-doc" href="'+src+'" target="_blank"><span class="doc-ico">📄</span><span class="doc-name">'+esc(m.filename||'documento')+'</span><span class="doc-dl">abrir</span></a>';
        return esc(m.text||'');
      }
      // force=true só quando ABRE a conversa (aí sim vai pro fim).
      // Nos refreshes automáticos NUNCA arrasta a tela: só desce sozinho se o
      // usuário já estava colado no rodapé; se ele rolou pra cima, fica onde está.
      function renderMsgs(msgs, force){
        var box=$('msgs');
        var MEDIA=['image','audio','video','document','sticker'];
        state.msgs = msgs||[];
        // índice por wamid p/ montar o trecho citado
        var porWamid={}; state.msgs.forEach(function(m){ if(m.wamid) porWamid[m.wamid]=m; });
        var html=state.msgs.map(function(m){
          var isMedia = MEDIA.indexOf(m.type)>=0 && m.mediaId;
          var cls='b '+(m.direction==='out'?('out'+(m.agent?' agent':'')):'in')+((m.type==='image'||m.type==='sticker'||m.type==='video')&&m.mediaId?' media':'');
          var who=(m.direction==='out')?(m.agent?'Atendente':'Bot'):'';
          var inner;
          if(isMedia){ var cap=String(m.text||'').replace(/^\[[^\]]*\]\s*/,''); inner=mediaHtml(m)+(cap?('<div class="cap">'+esc(cap)+'</div>'):''); }
          else inner=esc(m.text);
          // Bloco da mensagem CITADA (quando esta responde a outra)
          var quote='';
          if(m.replyTo && porWamid[m.replyTo]){
            var q=porWamid[m.replyTo];
            var qwho=(q.direction==='out')?(q.agent?'Atendente':'Bot'):'Cliente';
            quote='<div class="quoted"><div class="q-who">'+qwho+'</div><div class="q-txt">'+esc(String(q.text||'').slice(0,120))+'</div></div>';
          }
          var btn = m.wamid ? '<button type="button" class="reply-btn" data-wamid="'+esc(m.wamid)+'" title="Responder esta mensagem">↩</button>' : '';
          return '<div class="'+cls+'">'+btn+(who?'<div class="who">'+who+'</div>':'')+quote+inner+'<div class="meta">'+fmtTime(m.createdAt)+'</div></div>';
        }).join('');
        // Nada mudou? não redesenha (evita piscar áudio/imagem e perder o scroll).
        if(!force && html===state._msgsHtml) return;
        var perto=(box.scrollHeight-box.scrollTop-box.clientHeight)<80; // usuário estava no rodapé?
        var topoAntes=box.scrollTop;
        box.innerHTML=html;
        state._msgsHtml=html;
        if(force || perto) box.scrollTop=box.scrollHeight;
        else box.scrollTop=topoAntes;   // respeita onde o usuário parou
      }

      function setBotBtn(paused){
        state.botPaused=paused;
        var b=$('botBtn');
        if(paused){ b.className='btn-bot off'; b.textContent='▶ Dar Play (IA)'; $('pausedHint').style.display='block'; }
        else { b.className='btn-bot on'; b.textContent='⏸ Pausar IA'; $('pausedHint').style.display='none'; }
      }

      // Volta pra lista de conversas (celular).
      function voltarLista(){
        $('crm').classList.remove('show-thread');
        state.current=null; state.replyTo=null; $('replyBar').style.display='none';
        renderConvs();
        try{ window.scrollTo(0,0); }catch(_){}
      }

      async function openChat(phone, name){
        var jaAberto=$('crm').classList.contains('show-thread');
        state.current=phone; state.currentName=name;
        $('emptyThread').style.display='none'; $('threadInner').style.display='flex';
        $('crm').classList.add('show-thread');
        // No celular a lista some: registra no histórico pra tecla/gesto "voltar"
        // do aparelho trazer de volta a lista em vez de sair da página.
        var jaNoHistorico=!!(history.state && history.state.crmThread);
        if(!jaAberto && !jaNoHistorico && window.innerWidth<=820){ try{ history.pushState({ crmThread:1 }, ''); }catch(_){} }
        try{ window.scrollTo(0,0); }catch(_){}
        fitHeight();
        $('tName').textContent=name || ('+'+phone); $('tPhone').textContent='+'+phone; $('tAvatar').textContent=initials(name,phone);
        renderConvs();
        var d=await api('/api/painel/ia-crm/messages?phone='+encodeURIComponent(phone));
        if(d&&d.ok){ renderMsgs(d.messages, true); setBotBtn(d.botPaused); if(d.name){ state.currentName=d.name; $('tName').textContent=d.name; } }
      }

      // force=true só quando VOCÊ acabou de enviar/agir (aí desce pro fim de propósito).
      async function refreshOpen(force){
        if(!state.current) return;
        var d=await api('/api/painel/ia-crm/messages?phone='+encodeURIComponent(state.current));
        if(d&&d.ok){ renderMsgs(d.messages, force===true); setBotBtn(d.botPaused); }
      }

      // Eventos
      $('convList').addEventListener('click', function(ev){ var c=ev.target.closest('.conv'); if(!c) return; openChat(c.getAttribute('data-phone'), c.getAttribute('data-name')); });
      $('backBtn').addEventListener('click', function(){
        if(history.state && history.state.crmThread){ history.back(); return; }  // desfaz o pushState
        voltarLista();
      });
      // Botão/gesto "voltar" do aparelho e tecla Esc também voltam pra lista.
      window.addEventListener('popstate', function(){ if($('crm').classList.contains('show-thread')) voltarLista(); });
      document.addEventListener('keydown', function(e){
        if(e.key==='Escape' && state.current && window.innerWidth<=820){ $('backBtn').click(); }
      });
      // O menu do painel abre/fecha e muda a altura do topo: recalcula.
      var sbToggle=document.getElementById('sidebarToggle');
      if(sbToggle) sbToggle.addEventListener('change', function(){ setTimeout(fitHeight, 30); });
      $('tabs').addEventListener('click', function(ev){
        var b=ev.target.closest('.tab'); if(!b) return;
        var t=b.getAttribute('data-tab'); var cfg=TABS[t]; if(!cfg) return;
        document.querySelectorAll('#tabs .tab').forEach(function(x){ x.classList.remove('active'); });
        b.classList.add('active');
        var mudouEscopo=(state.scope!==cfg.scope);
        state.tab=t; state.scope=cfg.scope; state.answer=cfg.answer;
        if(mudouEscopo) loadConvs(); else renderConvs();
      });
      $('search').addEventListener('input', function(){ state.filter=this.value; renderConvs(); });
      $('botBtn').addEventListener('click', async function(){
        if(!state.current) return;
        var target=!state.botPaused; // se ligado -> pausa (você atende); se pausado -> religa
        var d=await api('/api/painel/ia-crm/bot', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone: state.current, paused: target }) });
        if(d&&d.ok){ setBotBtn(d.botPaused); loadConvs(); }
      });
      async function send(){
        var txt=$('msgInput').value.trim(); if(!txt||!state.current) return;
        $('sendBtn').disabled=true;
        var d=await api('/api/painel/ia-crm/send', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone: state.current, text: txt, replyTo: state.replyTo || '' }) });
        $('sendBtn').disabled=false;
        if(d&&d.ok){ $('msgInput').value=''; $('msgInput').style.height='auto'; clearReply(); setBotBtn(true); await refreshOpen(true); loadConvs(); }
        else { alert('Falha ao enviar: '+((d&&(d.detail||d.error))||'erro')); }
      }
      // Responder mensagem específica (citação) — vale p/ mensagem do cliente e nossa.
      function setReply(wamid){
        var m=(state.msgs||[]).find(function(x){ return x.wamid===wamid; }); if(!m) return;
        state.replyTo=wamid;
        $('rbWho').textContent=(m.direction==='out')?(m.agent?'Atendente':'Bot'):'Cliente';
        $('rbTxt').textContent=String(m.text||'').slice(0,140);
        $('replyBar').style.display='flex';
        $('msgInput').focus();
      }
      function clearReply(){ state.replyTo=null; $('replyBar').style.display='none'; }
      $('rbCancel').addEventListener('click', clearReply);
      $('msgs').addEventListener('click', function(ev){
        var b=ev.target.closest('.reply-btn'); if(!b) return;
        ev.stopPropagation(); setReply(b.getAttribute('data-wamid'));
      });
      $('sendBtn').addEventListener('click', send);
      // Celular (Android/iOS): a tecla Enter do teclado deve QUEBRAR LINHA — quem envia
      // é o botão. No desktop: Enter envia, Ctrl+Enter e Shift+Enter quebram linha.
      var IS_MOBILE = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) || ('ontouchstart' in window && window.innerWidth < 900);
      function autoGrow(){ var el=$('msgInput'); el.style.height='auto'; el.style.height=Math.min(el.scrollHeight,120)+'px'; }
      $('msgInput').addEventListener('input', autoGrow);
      $('msgInput').addEventListener('keydown', function(e){
        if(e.key!=='Enter') return;
        if(IS_MOBILE) return;                 // celular: deixa quebrar linha
        if(e.ctrlKey||e.metaKey||e.shiftKey) return; // Ctrl/Cmd/Shift+Enter: quebra linha
        e.preventDefault(); send();
      });

      // Anexar / enviar mídia
      function upmsg(t, err){ var e=$('upMsg'); e.textContent=t||''; e.className='upmsg'+(err?' err':''); }
      async function uploadFile(file){
        if(!file || !state.current) return;
        upmsg('Enviando '+(file.name||'arquivo')+'…');
        var fd=new FormData(); fd.append('file', file); fd.append('phone', state.current);
        try {
          var r=await fetch('/api/painel/ia-crm/send-media', { method:'POST', credentials:'same-origin', body: fd });
          var d=await r.json().catch(function(){ return null; });
          if(d&&d.ok){ upmsg(''); setBotBtn(true); await refreshOpen(true); loadConvs(); }
          else { upmsg('Falha: '+((d&&d.message)||(d&&d.error)||'erro'), true); }
        } catch(e){ upmsg('Erro de rede ao enviar.', true); }
      }
      $('attachBtn').addEventListener('click', function(){ if(!state.current){ alert('Abra uma conversa primeiro.'); return; } $('fileInput').click(); });
      $('fileInput').addEventListener('change', function(){ var f=this.files&&this.files[0]; if(f) uploadFile(f); this.value=''; });

      // Gravar áudio (voz)
      var mediaRecorder=null, recChunks=[], recording=false, recStream=null;
      $('micBtn').addEventListener('click', async function(){
        if(!state.current){ alert('Abra uma conversa primeiro.'); return; }
        if(recording){ try{ mediaRecorder.stop(); }catch(_){} return; }
        if(!navigator.mediaDevices || !window.MediaRecorder){ alert('Seu navegador não suporta gravação de áudio.'); return; }
        try {
          recStream=await navigator.mediaDevices.getUserMedia({ audio:true });
          var mime = (MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported('audio/ogg;codecs=opus')) ? 'audio/ogg;codecs=opus'
            : ((MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported('audio/webm;codecs=opus')) ? 'audio/webm;codecs=opus' : '');
          mediaRecorder = mime ? new MediaRecorder(recStream,{ mimeType:mime }) : new MediaRecorder(recStream);
          recChunks=[];
          mediaRecorder.ondataavailable=function(e){ if(e.data&&e.data.size) recChunks.push(e.data); };
          mediaRecorder.onstop=async function(){
            recording=false; $('micBtn').classList.remove('rec'); $('micBtn').textContent='🎤';
            try{ recStream.getTracks().forEach(function(t){ t.stop(); }); }catch(_){}
            var type=(mediaRecorder.mimeType||'audio/webm').split(';')[0];
            var ext=type.indexOf('ogg')>=0?'ogg':(type.indexOf('mp4')>=0?'mp4':'webm');
            var blob=new Blob(recChunks,{ type:type });
            await uploadFile(new File([blob],'audio.'+ext,{ type:type }));
          };
          mediaRecorder.start(); recording=true; $('micBtn').classList.add('rec'); $('micBtn').textContent='⏹'; upmsg('Gravando… toque no ⏹ para enviar.');
        } catch(e){ alert('Não consegui acessar o microfone. Verifique a permissão.'); }
      });

      // Polling
      loadConvs();
      setInterval(loadConvs, 5000);
      setInterval(refreshOpen, 3000);
    })();
  </script>
</body>
</html>
