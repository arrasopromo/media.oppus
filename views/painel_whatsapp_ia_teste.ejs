<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IA WhatsApp (Teste)</title>
  <link href="/css/style.css" rel="stylesheet" />
  <style>
    body { font-family: sans-serif; background: #f0f2f5; color: #333; margin: 0; padding: 0; }
    h1 { margin: 0 0 6px; }
    .sub { color: #6b7280; font-size: 0.9rem; margin-bottom: 14px; }
    .wrap { max-width: 620px; }
    .chat { background: #e5ded8; border: 1px solid #d5cdc4; border-radius: 12px; height: 62vh; min-height: 360px; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 8px; }
    .msg { max-width: 78%; padding: 8px 11px; border-radius: 10px; font-size: 0.9rem; line-height: 1.35; white-space: pre-wrap; word-wrap: break-word; box-shadow: 0 1px 1px rgba(0,0,0,0.08); }
    .me { align-self: flex-end; background: #d9fdd3; }
    .ia { align-self: flex-start; background: #fff; }
    .sys { align-self: center; background: transparent; color: #6b7280; font-size: 0.78rem; box-shadow: none; }
    .composer { display: flex; gap: 8px; margin-top: 10px; }
    .composer input { flex: 1; padding: 11px 13px; border: 1px solid #cbd5e1; border-radius: 22px; font-size: 0.92rem; outline: none; }
    .composer button { padding: 0 18px; border: none; border-radius: 22px; background: #25d366; color: #fff; font-weight: 700; cursor: pointer; }
    .composer button:disabled { opacity: 0.5; cursor: not-allowed; }
    .bar { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; flex-wrap: wrap; }
    .btn2 { padding: 6px 12px; border: 1px solid #cbd5e1; background: #fff; border-radius: 8px; cursor: pointer; font-size: 0.82rem; }
    .btn2:hover { background: #f1f5f9; }
    .chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 10px; }
    .chip { padding: 5px 10px; border: 1px solid #c7d2fe; background: #eef2ff; color: #4f46e5; border-radius: 999px; cursor: pointer; font-size: 0.8rem; }
    .chip:hover { background: #e0e7ff; }
    .warn { background: #fef3c7; color: #92400e; padding: 8px 12px; border-radius: 8px; font-size: 0.82rem; margin-bottom: 12px; }
    .off { display: none; }
  </style>
</head>
<body>
  <%- include('partials/painel_sidebar', { page: 'whatsapp-ia-teste' }) %>
  <div class="main-content">
    <h1>IA WhatsApp — Teste</h1>
    <div class="sub">Converse com a IA como se fosse um cliente. Roda o mesmo cérebro do WhatsApp (cotação, tabela, validação de perfil), <strong>sem enviar nada pelo WhatsApp</strong> nem tocar no número/DataCrazy.</div>

    <div class="warn">⚠️ <b>Cuidado com "gerar Pix":</b> se você levar a conversa até o fim, a ferramenta <b>gerar_pix</b> cria um <b>pedido e cobrança REAIS</b> no banco. Para testar o fluxo, pare antes de confirmar o pagamento.</div>

    <div class="wrap">
      <div class="bar">
        <span class="sub" style="margin:0;">Sessão: <code id="sess"></code></span>
        <button type="button" id="resetBtn" class="btn2">↺ Nova conversa</button>
        <span id="statusMsg" class="sub" style="margin:0;"></span>
      </div>

      <div class="chips">
        <span class="chip" data-t="Oi, quanto custa 1000 seguidores brasileiros?">preço seguidores</span>
        <span class="chip" data-t="me mostra a tabela de curtidas">tabela curtidas</span>
        <span class="chip" data-t="qual o pacote mais barato de visualizações?">mais barato views</span>
        <span class="chip" data-t="qual a diferença de brasileiros pra reais?">reais x brasileiros</span>
        <span class="chip" data-t="quero seguidores e curtidas">pedido múltiplo</span>
        <span class="chip" data-t="quero falar com um atendente">suporte</span>
      </div>

      <div class="chat" id="chat"></div>

      <div class="composer">
        <input type="text" id="input" placeholder="Digite como cliente..." autocomplete="off">
        <button type="button" id="sendBtn">Enviar</button>
      </div>
    </div>
  </div>

  <script>
    (function(){
      function $(id){ return document.getElementById(id); }
      var chat = $('chat');
      function newPhone(){ return 'playground-' + Math.random().toString(36).slice(2, 8); }
      var phone = newPhone();
      $('sess').textContent = phone;

      function bubble(text, cls){
        var d = document.createElement('div');
        d.className = 'msg ' + cls;
        d.textContent = text;
        chat.appendChild(d);
        chat.scrollTop = chat.scrollHeight;
        return d;
      }
      bubble('Nova conversa iniciada. Mande a primeira mensagem (ou clique num atalho acima).', 'sys');

      // ── Cutucão de confirmação do @ (simulado no teste com contagem curta) ──
      var TEST_NUDGE_SECS = 15; // no WhatsApp real são ~120s; encurtado aqui pro teste
      var nudgeTimer = null, nudgeInterval = null, nudgeBubbleEl = null;
      function cancelNudge(userResponded){
        if (nudgeTimer) { clearTimeout(nudgeTimer); nudgeTimer = null; }
        if (nudgeInterval) { clearInterval(nudgeInterval); nudgeInterval = null; }
        if (nudgeBubbleEl) {
          if (userResponded) nudgeBubbleEl.textContent = '🔕 cutucão cancelado — você respondeu antes dos ' + TEST_NUDGE_SECS + 's.';
          nudgeBubbleEl = null;
        }
      }
      function scheduleNudge(previewText){
        cancelNudge(false);
        var remaining = TEST_NUDGE_SECS;
        var label = function(s){ return '⏳ aguardando o cliente… cutucão em ' + s + 's (responda pra cancelar). No WhatsApp real são ~120s.'; };
        nudgeBubbleEl = bubble(label(remaining), 'sys');
        nudgeInterval = setInterval(function(){
          remaining--;
          if (remaining > 0 && nudgeBubbleEl) nudgeBubbleEl.textContent = label(remaining);
        }, 1000);
        nudgeTimer = setTimeout(function(){
          if (nudgeInterval) { clearInterval(nudgeInterval); nudgeInterval = null; }
          if (nudgeBubbleEl) { nudgeBubbleEl.textContent = '🔔 cliente ficou sem responder — a IA enviou o cutucão:'; nudgeBubbleEl = null; }
          bubble(previewText, 'ia');
          nudgeTimer = null;
        }, TEST_NUDGE_SECS * 1000);
      }

      var busy = false;
      async function send(text){
        text = String(text || '').trim();
        if (!text || busy) return;
        cancelNudge(true); // cliente respondeu → cancela cutucão pendente
        busy = true; $('sendBtn').disabled = true;
        bubble(text, 'me');
        $('input').value = '';
        var typing = bubble('digitando…', 'ia');
        try {
          var r = await fetch('/api/whatsapp-ia/agent-test', { method:'POST', headers:{'Content-Type':'application/json','Accept':'application/json'}, credentials:'same-origin', body: JSON.stringify({ text: text, phone: phone }) });
          var d = await r.json().catch(function(){ return null; });
          typing.remove();
          if (d && d.ok) {
            if (!d.openai) bubble('(OpenAI desligada — respondendo pelo fallback de regras)', 'sys');
            (d.replies || []).forEach(function(msg){ bubble(msg, 'ia'); });
            if (!(d.replies || []).length) bubble('(sem resposta)', 'sys');
            // Se a IA entrou no estado "aguardando confirmação do @", agenda o cutucão.
            if (d.awaitingConfirm && d.nudgePreview) scheduleNudge(d.nudgePreview);
          } else {
            bubble('Erro: ' + ((d && (d.message || d.error)) || 'falha'), 'sys');
          }
        } catch (e) { typing.remove(); bubble('Erro de rede.', 'sys'); }
        busy = false; $('sendBtn').disabled = false; $('input').focus();
      }

      $('sendBtn').addEventListener('click', function(){ send($('input').value); });
      $('input').addEventListener('keydown', function(e){ if (e.key === 'Enter') { e.preventDefault(); send($('input').value); } });
      Array.prototype.slice.call(document.querySelectorAll('.chip')).forEach(function(c){
        c.addEventListener('click', function(){ send(c.getAttribute('data-t')); });
      });
      $('resetBtn').addEventListener('click', function(){
        cancelNudge(false);
        phone = newPhone(); $('sess').textContent = phone;
        chat.innerHTML = '';
        bubble('Nova conversa iniciada.', 'sys');
        $('input').focus();
      });
      $('input').focus();
    })();
  </script>
</body>
</html>
