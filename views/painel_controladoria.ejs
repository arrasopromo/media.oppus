<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Painel — Controladoria</title>
  <link href="/css/style.css" rel="stylesheet" />
  <style>
    :root {
      --eb:#6366f1; --sv:#0ea5a4; --cst:#ef4444; --luc:#16a34a;
      --ink:#1f2937; --muted:#6b7280; --soft:#9ca3af; --line:#edf0f4; --bg:#f6f7f9;
    }
    * { box-sizing:border-box; }
    body { font-family:'Segoe UI',system-ui,sans-serif; background:var(--bg); color:var(--ink); margin:0; }
    .main-content { padding:28px 32px 60px; }
    .card { background:#fff; border:1px solid var(--line); border-radius:16px; padding:20px 22px; margin-bottom:16px; }

    .head { display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:8px; }
    .head h1 { margin:0; font-size:1.45rem; font-weight:600; letter-spacing:-0.01em; color:#111827; }
    .head .sub { margin:2px 0 0; color:var(--muted); font-size:0.9rem; font-weight:400; }
    .statechip { font-size:0.78rem; font-weight:600; padding:6px 12px; border-radius:999px; white-space:nowrap; }
    .statechip.sim { background:#fef3c7; color:#92400e; border:1px solid #fde68a; }
    .statechip.on { background:#dcfce7; color:#166534; border:1px solid #bbf7d0; }
    .section { font-size:0.82rem; font-weight:600; color:var(--soft); margin:0 0 14px; text-transform:uppercase; letter-spacing:0.04em; display:flex; align-items:center; gap:10px; }
    .section .r { margin-left:auto; text-transform:none; letter-spacing:0; color:var(--muted); font-weight:500; }

    /* Faturamento */
    .fat-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:16px; }
    .fat { position:relative; overflow:hidden; background:#fff; border:1px solid var(--line); border-radius:16px; padding:18px 20px; }
    .fat::before { content:''; position:absolute; left:0; top:0; bottom:0; width:4px; background:#cbd5e1; }
    .fat.eb::before { background:var(--eb); } .fat.sv::before { background:var(--sv); }
    .fat .lbl { font-size:0.82rem; color:var(--muted); font-weight:500; display:flex; align-items:center; gap:7px; }
    .fat .lbl .dot { width:8px; height:8px; border-radius:50%; }
    .fat .val { font-size:1.9rem; font-weight:700; margin-top:8px; letter-spacing:-0.02em; color:#111827; }
    .fat .val small { font-size:0.95rem; color:var(--soft); font-weight:500; margin-right:3px; }
    .fat.eb .val { color:var(--eb); } .fat.sv .val { color:var(--sv); }
    .fat .cap { font-size:0.8rem; color:var(--soft); margin-top:6px; font-weight:400; }

    /* Proporção */
    .propbar { height:14px; border-radius:999px; overflow:hidden; display:flex; background:#eef1f6; }
    .propbar .seg { height:100%; transition:width .3s; }
    .propbar .seg.eb { background:var(--eb); } .propbar .seg.sv { background:var(--sv); }
    .prop-legend { display:flex; gap:20px; margin-top:11px; font-size:0.84rem; color:var(--muted); flex-wrap:wrap; font-weight:400; }
    .prop-legend .it { display:flex; align-items:center; gap:7px; }
    .prop-legend .sw { width:10px; height:10px; border-radius:3px; }

    /* Mini métricas */
    .mini-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:14px; }
    .mini { background:#fff; border:1px solid var(--line); border-radius:13px; padding:14px 16px; }
    .mini .ml { font-size:0.78rem; color:var(--muted); font-weight:500; }
    .mini .mv { font-size:1.35rem; font-weight:700; margin-top:4px; letter-spacing:-0.01em; }
    .mini .ms { font-size:0.76rem; color:var(--soft); margin-top:3px; }
    .mini.cst .mv { color:var(--cst); } .mini.luc .mv { color:var(--luc); }
    .mini.tax { background:#111827; border-color:#111827; } .mini.tax .ml { color:#9ca3af; } .mini.tax .mv { color:#fff; } .mini.tax .ms { color:#86efac; }

    /* Forms */
    .row { display:flex; gap:10px; flex-wrap:wrap; align-items:flex-end; }
    .field { display:flex; flex-direction:column; gap:5px; }
    .field label { font-size:0.76rem; color:var(--muted); font-weight:500; }
    .field input { border:1px solid #dfe4ec; border-radius:10px; padding:9px 12px; font-size:0.92rem; background:#fbfcfe; color:var(--ink); }
    .field input:focus { outline:none; border-color:var(--eb); box-shadow:0 0 0 3px rgba(99,102,241,0.1); }
    .btn { border:1px solid #dfe4ec; border-radius:10px; padding:9px 14px; font-weight:600; cursor:pointer; background:#fff; color:var(--ink); font-size:0.88rem; transition:all .15s; }
    .btn:hover { background:#f8fafc; }
    .btn.primary { background:var(--eb); color:#fff; border:0; }
    .btn.primary:hover { filter:brightness(1.05); }
    .btn.chip { border-radius:999px; background:#f3f4f6; border:1px solid #e5e7eb; padding:8px 14px; font-size:0.84rem; }

    .badge { display:inline-flex; align-items:center; padding:3px 10px; border-radius:999px; font-size:0.74rem; font-weight:600; border:1px solid transparent; }
    .badge.first { background:#eef2ff; border-color:#c7d2fe; color:#4338ca; }
    .badge.rep { background:#f3f4f6; border-color:#e5e7eb; color:#4b5563; }
    .badge.pre { background:#fef3c7; border-color:#fde68a; color:#92400e; }

    table { width:100%; border-collapse:collapse; }
    th, td { padding:11px 13px; text-align:left; border-bottom:1px solid #f0f2f5; font-size:0.88rem; font-weight:400; }
    th { background:#fafbfc; font-weight:600; color:var(--soft); font-size:0.72rem; text-transform:uppercase; letter-spacing:0.04em; }
    tbody tr:hover { background:#fafbff; } tbody tr:last-child td { border-bottom:0; }
    td.num { text-align:right; font-variant-numeric:tabular-nums; }
    .mono { font-family:ui-monospace,Menlo,Consolas,monospace; font-size:0.8rem; color:var(--muted); }
    .panel-table-scroll { width:100%; overflow-x:auto; border:1px solid var(--line); border-radius:12px; }
    .ok { color:var(--luc); font-weight:600; }

    @media (max-width:820px){ .fat-grid { grid-template-columns:1fr; } }
  </style>
</head>
<body class="painel-page">
  <%- include('partials/painel_sidebar', { page: 'controladoria' }) %>
  <div class="main-content">

    <div class="head">
      <div>
        <h1>Controladoria</h1>
        <p class="sub">Divisão de faturamento entre ebook e serviço.</p>
      </div>
      <% if (emission && emission.ativa) { %>
        <span class="statechip on">Ativo<%= cfg.cutoffDate ? ' · desde ' + new Date(cfg.cutoffMs).toLocaleDateString('pt-BR') : '' %></span>
      <% } else { %>
        <span class="statechip sim">Simulação</span>
      <% } %>
    </div>

    <!-- Período -->
    <div class="card">
      <div class="section">Período
        <span class="r">
          <%= filter.start ? new Date(filter.start+'T12:00:00').toLocaleDateString('pt-BR') : 'início' %>
          &rarr;
          <%= filter.end ? new Date(filter.end+'T12:00:00').toLocaleDateString('pt-BR') : 'hoje' %>
        </span>
      </div>
      <div class="row" style="margin-bottom:14px;">
        <button type="button" class="btn chip" onclick="filtroRapido('mesAtual')">Este mês</button>
        <button type="button" class="btn chip" onclick="filtroRapido('mesPassado')">Mês passado</button>
        <button type="button" class="btn chip" onclick="filtroRapido('maximo')">Máximo</button>
      </div>
      <form class="row" method="get" action="/painel/controladoria">
        <div class="field"><label>De</label><input type="date" name="start" value="<%= filter.start %>" /></div>
        <div class="field"><label>Até</label><input type="date" name="end" value="<%= filter.end %>" /></div>
        <button class="btn" type="submit">Filtrar</button>
      </form>
    </div>

    <!-- Faturamento -->
    <div class="fat-grid">
      <div class="fat">
        <div class="lbl">Faturamento total</div>
        <div class="val"><small>R$</small><%= totals.revenue.toFixed(2) %></div>
        <div class="cap"><%= totals.orders %> pedidos</div>
      </div>
      <div class="fat eb">
        <div class="lbl"><span class="dot" style="background:var(--eb)"></span>Ebook</div>
        <div class="val"><small>R$</small><%= totals.ebook.toFixed(2) %></div>
        <div class="cap"><%= totals.ebookPctReal %>% do total</div>
      </div>
      <div class="fat sv">
        <div class="lbl"><span class="dot" style="background:var(--sv)"></span>Serviço</div>
        <div class="val"><small>R$</small><%= totals.servico.toFixed(2) %></div>
        <div class="cap"><%= totals.servicoPctReal %>% do total</div>
      </div>
    </div>

    <!-- Decomposição: 1ª compra × recompra (soma = faturamento total) -->
    <div class="fat-grid">
      <div class="fat">
        <div class="lbl">Faturamento 1ª compra</div>
        <div class="val"><small>R$</small><%= totals.firstRevenue.toFixed(2) %></div>
        <div class="cap"><%= totals.firstPctOfTotal %>% do total · <%= totals.firstCount %> pedidos</div>
      </div>
      <div class="fat">
        <div class="lbl">Faturamento recompra</div>
        <div class="val"><small>R$</small><%= totals.repeatRevenue.toFixed(2) %></div>
        <div class="cap"><%= totals.revenue > 0 ? (totals.repeatRevenue / totals.revenue * 100).toFixed(2) : '0.00' %>% do total · <%= totals.repeatCount %> pedidos · 100% serviço</div>
        <div class="cap" style="color:#94a3b8;margin-top:2px;">recompra por e-mail/@/CPF — difere do card "LTV" do dashboard (só @)</div>
      </div>
      <div class="fat eb">
        <div class="lbl"><span class="dot" style="background:var(--eb)"></span>Ebook (só da 1ª compra)</div>
        <div class="val"><small>R$</small><%= totals.ebook.toFixed(2) %></div>
        <div class="cap"><%= totals.ebookPctOfFirst %>% da 1ª compra · serviço da 1ª: R$ <%= (totals.firstRevenue - totals.ebook).toFixed(2) %></div>
      </div>
    </div>
    <% if (totals.preCutoffRevenue > 0) { %>
      <div class="card" style="padding:12px 18px;color:var(--muted);font-size:0.85rem;">
        Inclui R$ <%= totals.preCutoffRevenue.toFixed(2) %> de pedidos <b>pré-corte</b> (antes da data de corte, 100% serviço) — por isso 1ª compra + recompra pode não fechar o total quando há corte definido.
      </div>
    <% } %>

    <!-- Ebook: ticket médio + top vendas -->
    <% var _ebkTm = (typeof ebookTicketMedio !== 'undefined') ? Number(ebookTicketMedio) : 0;
       var _ebkN = (typeof ebookOrdersCount !== 'undefined') ? Number(ebookOrdersCount) : 0;
       var _topEbk = (typeof topEbookSales !== 'undefined' && Array.isArray(topEbookSales)) ? topEbookSales : []; %>
    <div class="fat-grid">
      <div class="fat eb">
        <div class="lbl"><span class="dot" style="background:var(--eb)"></span>Ticket médio do ebook</div>
        <div class="val"><small>R$</small><%= _ebkTm.toFixed(2) %></div>
        <div class="cap"><%= _ebkN %> pedido(s) com ebook · total R$ <%= totals.ebook.toFixed(2) %></div>
      </div>
    </div>

    <div class="card">
      <div class="section">Top vendas de ebook <span class="r"><%= _topEbk.length %><% if (_ebkN > _topEbk.length) { %> de <%= _ebkN %><% } %></span></div>
      <% if (typeof emission === 'undefined' || !emission.ativa) { %>
        <div class="cap" style="color:#94a3b8;margin:-2px 0 12px;">Valores <b>simulados</b> pela regra de split (emissão de nota ainda desligada).</div>
      <% } %>
      <div class="panel-table-scroll">
        <table>
          <thead>
            <tr>
              <th>Data</th><th>Pedido</th><th>@ Cliente</th>
              <th class="num">Valor do pedido</th><th class="num">Ebook vendido</th>
            </tr>
          </thead>
          <tbody>
            <% _topEbk.forEach(function(r){ %>
              <tr>
                <td class="mono"><%= r.dateMs ? new Date(r.dateMs).toLocaleDateString('pt-BR') : '—' %></td>
                <td class="mono"><%= r.id || '—' %></td>
                <td class="mono"><%= r.instagram ? ('@'+r.instagram) : '—' %></td>
                <td class="num">R$ <%= Number(r.valueReais||0).toFixed(2) %></td>
                <td class="num" style="color:var(--eb);font-weight:600;">R$ <%= Number(r.ebook||0).toFixed(2) %></td>
              </tr>
            <% }); %>
            <% if (!_topEbk.length) { %>
              <tr><td colspan="5" style="text-align:center;color:var(--soft);padding:28px;">Nenhuma venda de ebook neste período.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Proporção -->
    <div class="card">
      <div class="section">Proporção</div>
      <div class="propbar">
        <div class="seg eb" style="width:<%= totals.ebookPctReal %>%"></div>
        <div class="seg sv" style="width:<%= totals.servicoPctReal %>%"></div>
      </div>
      <div class="prop-legend">
        <span class="it"><span class="sw" style="background:var(--eb)"></span>Ebook · R$ <%= totals.ebook.toFixed(2) %> (<%= totals.ebookPctReal %>%)</span>
        <span class="it"><span class="sw" style="background:var(--sv)"></span>Serviço · R$ <%= totals.servico.toFixed(2) %> (<%= totals.servicoPctReal %>%)</span>
      </div>
    </div>

    <!-- Impostos -->
    <div class="card">
      <div class="section">Impostos</div>
      <div class="mini-grid">
        <div class="mini"><div class="ml">Imposto ebook (<%= Math.round(cfg.ebookTaxPct*100) %>%)</div><div class="mv" style="color:var(--eb)">R$ <%= totals.ebookTax.toFixed(2) %></div></div>
        <div class="mini"><div class="ml">Imposto serviço (<%= Math.round(cfg.servicoTaxPct*100) %>%)</div><div class="mv" style="color:var(--sv)">R$ <%= totals.servicoTax.toFixed(2) %></div></div>
        <div class="mini tax"><div class="ml">Imposto total</div><div class="mv">R$ <%= totals.taxTotal.toFixed(2) %></div><div class="ms">economia de R$ <%= totals.taxSaving.toFixed(2) %> vs 100% serviço</div></div>
      </div>
    </div>

    <!-- Custos e deduções -->
    <div class="card">
      <div class="section">Custos e deduções</div>
      <div class="mini-grid">
        <div class="mini cst"><div class="ml">Custo operacional</div><div class="mv">R$ <%= totals.custoOperacional.toFixed(2) %></div><div class="ms">fornecedor / serviço</div></div>
        <div class="mini cst"><div class="ml">Custo ads</div><div class="mv">R$ <%= totals.adsCost.toFixed(2) %></div><div class="ms">
          <% if (ads && ads.ok) { %>Facebook · <%= ads.since %> a <%= ads.until %><% } else { %><span style="color:#b45309">indisponível<%= ads && ads.error ? ' ('+ads.error+')' : '' %></span><% } %>
        </div></div>
        <div class="mini cst"><div class="ml">Imposto ads (<%= Math.round(cfg.adsTaxPct*100*10)/10 %>%)</div><div class="mv">R$ <%= totals.adsTax.toFixed(2) %></div></div>
        <div class="mini cst"><div class="ml">Imposto vendas</div><div class="mv">R$ <%= totals.impostoVendas.toFixed(2) %></div><div class="ms">ebook <%= Math.round(cfg.ebookTaxPct*100*10)/10 %>% + serviço <%= Math.round(cfg.servicoTaxPct*100*10)/10 %>%</div></div>
        <div class="mini tax"><div class="ml">Deduções total</div><div class="mv">R$ <%= totals.deducoesTotal.toFixed(2) %></div><div class="ms">operacional + ads + imposto ads + imposto vendas</div></div>
      </div>
    </div>

    <!-- Resultado -->
    <div class="card">
      <div class="mini-grid">
        <div class="mini luc"><div class="ml">Lucro</div><div class="mv">R$ <%= totals.lucro.toFixed(2) %></div><div class="ms">faturamento − deduções total</div></div>
        <div class="mini"><div class="ml">1ª compra</div><div class="mv"><%= totals.firstCount %></div></div>
        <div class="mini"><div class="ml">Recompra</div><div class="mv"><%= totals.repeatCount %></div></div>
      </div>
    </div>

    <!-- Notas Fiscais -->
    <% var nf = totals.nf || {}; var nfe = totals.nfEbook || {}; %>
    <div class="card">
      <div class="section">Notas Fiscais
        <span class="r"><a href="/painel/notas-fiscais?state=held" style="color:#b45309;font-weight:700;text-decoration:none;">corrigir represadas &rarr;</a></span>
      </div>
      <div class="mini-grid">
        <div class="mini"><div class="ml">Pedidos gerados</div><div class="mv"><%= totals.orders %></div><div class="ms">no período</div></div>
        <div class="mini"><div class="ml">NF geradas</div><div class="mv" style="color:#16a34a"><%= nf.authorized || 0 %></div><div class="ms"><%= totals.orders > 0 ? Math.round((nf.authorized||0)/totals.orders*100) : 0 %>% dos pedidos</div></div>
        <div class="mini"><div class="ml">Na fila</div><div class="mv" style="color:#0369a1"><%= nf.queued || 0 %></div></div>
        <div class="mini" style="<%= (nf.held||0) > 0 ? 'background:#fffbeb;border-color:#fde68a;' : '' %>"><div class="ml">Represadas</div><div class="mv" style="color:#b45309"><%= nf.held || 0 %></div><div class="ms">sem CPF</div></div>
        <div class="mini"><div class="ml">Erro / rejeitada</div><div class="mv" style="color:#b91c1c"><%= (nf.error||0) + (nf.rejected||0) %></div></div>
        <div class="mini"><div class="ml">Sem NF ainda</div><div class="mv" style="color:#64748b"><%= nf.none || 0 %></div></div>
      </div>
    </div>

    <!-- Notas Fiscais — Ebook (1ª compra) -->
    <div class="card">
      <div class="section" style="color:var(--eb)">Notas Fiscais — Ebook (1ª compra)</div>
      <div class="mini-grid">
        <div class="mini eb"><div class="ml">Pedidos com ebook</div><div class="mv" style="color:var(--eb)"><%= nfe.total || 0 %></div><div class="ms">exigem NF de ebook (CPF+end.)</div></div>
        <div class="mini"><div class="ml">NF ebook geradas</div><div class="mv" style="color:#16a34a"><%= nfe.authorized || 0 %></div><div class="ms"><%= (nfe.total||0) > 0 ? Math.round((nfe.authorized||0)/(nfe.total||1)*100) : 0 %>% dos ebooks</div></div>
        <div class="mini"><div class="ml">Na fila</div><div class="mv" style="color:#0369a1"><%= nfe.queued || 0 %></div></div>
        <div class="mini" style="<%= (nfe.held||0) > 0 ? 'background:#fffbeb;border-color:#fde68a;' : '' %>"><div class="ml">Represadas</div><div class="mv" style="color:#b45309"><%= nfe.held || 0 %></div><div class="ms">falta CPF</div></div>
        <div class="mini"><div class="ml">Erro / rejeitada</div><div class="mv" style="color:#b91c1c"><%= (nfe.error||0) + (nfe.rejected||0) %></div></div>
        <div class="mini"><div class="ml">Sem NF ainda</div><div class="mv" style="color:#64748b"><%= nfe.none || 0 %></div></div>
      </div>
    </div>

    <!-- Tabela -->
    <div class="card">
      <div class="section">Pedidos <span class="r"><%= rowsCount %><% if (rowsCount > rows.length) { %> (exibindo <%= rows.length %>)<% } %></span></div>
      <div class="panel-table-scroll">
        <table>
          <thead>
            <tr>
              <th>Data</th><th>Cliente</th><th>Serviço</th><th>Tipo</th>
              <th class="num">Valor</th><th class="num">Ebook</th><th class="num">Serviço</th><th class="num">Custo</th><th>NF</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(function(r){ %>
              <tr>
                <td class="mono"><%= new Date(r.dateMs).toLocaleDateString('pt-BR') %></td>
                <td>
                  <% if (r.preCutoff) { %><span class="badge pre">pré-corte</span><% } else if (r.isFirst) { %><span class="badge first">1ª compra</span><% } else { %><span class="badge rep">recompra</span><% } %>
                  <div class="mono" style="margin-top:5px;">
                    <%= r.instagram ? ('@'+r.instagram) : '' %><%= (r.instagram && r.email) ? ' · ' : '' %><%= r.email %>
                  </div>
                </td>
                <td><%= r.categoria || '-' %></td>
                <td><%= r.tipo || '-' %></td>
                <td class="num">R$ <%= r.valueReais.toFixed(2) %></td>
                <td class="num" style="color:var(--eb);"><%= r.ebook > 0 ? 'R$ ' + r.ebook.toFixed(2) : '—' %></td>
                <td class="num" style="color:var(--sv);">R$ <%= r.servico.toFixed(2) %></td>
                <td class="num" style="color:var(--cst);">R$ <%= r.costReais.toFixed(2) %></td>
                <td>
                  <% var nfb = r.nfBucket || 'none';
                     var nfLabel = { authorized:'gerada', queued:'na fila', held:'represada', error:'erro', rejected:'rejeitada', none:'—' }[nfb] || nfb;
                     var nfColor = { authorized:'#166534', queued:'#075985', held:'#92400e', error:'#991b1b', rejected:'#991b1b', none:'#94a3b8' }[nfb] || '#94a3b8'; %>
                  <span style="color:<%= nfColor %>;font-weight:600;font-size:0.82rem;"><%= nfLabel %></span>
                </td>
              </tr>
            <% }); %>
            <% if (!rows.length) { %>
              <tr><td colspan="9" style="text-align:center;color:var(--soft);padding:28px;">Nenhum pedido pago neste período.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Configuração -->
    <div class="card">
      <div class="section">Configuração</div>
      <form class="row" id="cfgForm" onsubmit="return salvarCfg(event)">
        <div class="field"><label>% Ebook (1ª compra)</label><input type="number" step="1" min="0" max="100" name="ebookPct" value="<%= Math.round(cfg.ebookPct * 100) %>" /></div>
        <div class="field"><label>Teto do ebook (R$)</label><input type="number" step="1" min="0" name="ebookCapReais" value="<%= cfg.ebookCapReais %>" /></div>
        <div class="field"><label>% Imposto ebook</label><input type="number" step="0.1" min="0" max="100" name="ebookTaxPct" value="<%= Math.round(cfg.ebookTaxPct * 1000)/10 %>" /></div>
        <div class="field"><label>% Imposto serviço</label><input type="number" step="0.1" min="0" max="100" name="servicoTaxPct" value="<%= Math.round(cfg.servicoTaxPct * 1000)/10 %>" /></div>
        <div class="field"><label>% Imposto ads</label><input type="number" step="0.1" min="0" max="100" name="adsTaxPct" value="<%= Math.round(cfg.adsTaxPct * 1000)/10 %>" /></div>
        <div class="field"><label>Data de corte</label><input type="date" name="cutoffDate" value="<%= cfg.cutoffDate %>" /></div>
        <button class="btn primary" type="submit">Salvar</button>
        <span id="cfgMsg" class="ok" style="display:none;">Salvo</span>
      </form>
    </div>

  </div>

  <script>
    function ymd(d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }
    function filtroRapido(tipo) {
      const now = new Date();
      let start, end;
      if (tipo === 'mesAtual') { start = new Date(now.getFullYear(), now.getMonth(), 1); end = now; }
      else if (tipo === 'mesPassado') { start = new Date(now.getFullYear(), now.getMonth() - 1, 1); end = new Date(now.getFullYear(), now.getMonth(), 0); }
      else { window.location = '/painel/controladoria'; return; }
      window.location = '/painel/controladoria?start=' + ymd(start) + '&end=' + ymd(end);
    }
    async function salvarCfg(ev) {
      ev.preventDefault();
      const f = document.getElementById('cfgForm');
      const payload = { ebookPct: Number(f.ebookPct.value), ebookCapReais: Number(f.ebookCapReais.value), ebookTaxPct: Number(f.ebookTaxPct.value), servicoTaxPct: Number(f.servicoTaxPct.value), adsTaxPct: Number(f.adsTaxPct.value), cutoffDate: f.cutoffDate.value };
      try {
        const r = await fetch('/api/admin/controladoria/config', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const j = await r.json();
        if (j.ok) { document.getElementById('cfgMsg').style.display = 'inline'; setTimeout(function(){ location.reload(); }, 500); }
        else { alert('Erro ao salvar: ' + (j.error || 'desconhecido')); }
      } catch (e) { alert('Erro: ' + e.message); }
      return false;
    }
  </script>
</body>
</html>
