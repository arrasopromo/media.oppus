# Configurações do Baserow
BASEROW_TOKEN=YOUR_BASEROW_TOKEN
BASEROW_BASE_URL=https://your-baserow.example.com

# IDs das Tabelas do Baserow (substitua pelos IDs reais das suas tabelas)
BASEROW_ACCESS_LOG_TABLE_ID=631
BASEROW_PROFILES_TABLE_ID=456
BASEROW_WEBHOOKS_TABLE_ID=789

# Configurações do Google Drive (opcional)
# Use valores de ambiente locais; NÃO commit secrets reais.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://yourapp.example.com/oauth2callback

# Configurações dos Webhooks
WEBHOOK_POST_URL=https://your-webhook.example.com/post
WEBHOOK_GET_URL=https://your-webhook.example.com/get

# IP de Exceção (sem limitações de uso)
EXCEPTION_IP=

# SMS de recuperação (cupom 15%/30%) via MEX10
MEX10_TOKEN=
# Liga/desliga o SMS de recuperação. Default: ligado. Use false como kill switch.
ORDER_RECOVERY_SMS_ENABLED=true
# Allowlist de DEBUG (opcional): se preenchida, SÓ estes números recebem SMS (modo teste).
# Deixe VAZIO em produção para enviar a todos os clientes.
# Ex.: ORDER_RECOVERY_SMS_DEBUG_PHONES=31975938916,31996506838
ORDER_RECOVERY_SMS_DEBUG_PHONES=

# Link CURTO na recuperação (ex: https://site/aB3xK9). LIGADO por padrão.
# Sem ele a URL passa de 500 chars = 4 SMS por envio (4x o custo) e vira cara de spam.
# Kill switch: =false (volta a usar a URL longa).
RECOVERY_SHORT_LINKS_ENABLED=true

# Validade do link/token de recuperação, em horas. Default: 24 (1 dia).
# Antes eram 7 dias fixos — o cliente guardava a URL e comprava com desconto pra sempre.
# O link também morre automaticamente quando o pedido é pago / a recuperação converte.
RECOVERY_LINK_TTL_HOURS=24

# Cupons usados na recuperação
ORDER_RECOVERY_COUPON15_CODE=RECUP15
ORDER_RECOVERY_COUPON30_CODE=RECUP30

# Configurações do Telegram (para verificação de números)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_STRING_SESSION=

# Provedor Fama24h (seguidores/visualizações)
FAMA24H_API_KEY=YOUR_FAMA24H_API_KEY

# ── Sweeper de bumps travados em "processing" ──────────────────────────────
# Destrava sub-pedidos (comentários/views/curtidas) que ficaram presos em
# status='processing' quando o processo morre no meio do disparo. Reseta os
# presos há mais de STALE_MINUTES para 'unknown' (re-despacháveis + visíveis no
# painel de orderid unknown). NÃO re-despacha sozinho. Ligado por padrão.
STUCK_BUMP_SWEEPER_ENABLED=true
# Idade mínima (min) preso em 'processing' para ser destravado. Default 20.
STUCK_BUMP_STALE_MINUTES=20
# Intervalo (min) entre passadas do sweeper. Default 10.
STUCK_BUMP_SWEEP_MINUTES=10

# ── Fila de seguidores (1 pedido de seguidores por perfil de cada vez) ─────
# Se o MESMO perfil comprar seguidores 2x dentro da janela, o 2º pedido só é
# enviado ao fornecedor quando o 1º estiver CONCLUÍDO lá. Pedido único do
# perfil na janela → despacha na hora, sem consultar nada.
# Vale só para SEGUIDORES (curtidas/visualizações passam direto).
# Kill switch: =false (volta a despachar tudo imediatamente).
FOLLOWERS_QUEUE_ENABLED=true
# Janela em horas para considerar "pedido em cima do outro". Default 24.
FOLLOWERS_QUEUE_WINDOW_HOURS=24
# Válvula de segurança: se o pedido da frente travar no fornecedor, o represado
# é solto à força depois deste tempo (horas). Default 48. Nenhum pedido pago
# fica preso pra sempre.
FOLLOWERS_QUEUE_MAX_WAIT_HOURS=48
# Intervalo (ms) do loop que checa se o pedido da frente já concluiu. Default 5min.
FOLLOWERS_QUEUE_POLL_INTERVAL_MS=300000

# Provedor GGRAM (curtidas brasileiras)
GGRAM_API_KEY=YOUR_GGRAM_API_KEY
# Se usar likes brasileiras fixas, defina o service ID correspondente
GGRAM_SERVICE_ID_LIKES_BRS=1810
MONGODB_URI=mongodb://mongo:password@host:27017/?tls=false&authSource=admin
MONGODB_DB_NAME=site-whatsapp

# ============================================================================
# Nota Fiscal — Spedy (https://spedy.com.br)
# ----------------------------------------------------------------------------
# DESLIGADO por padrão. Enquanto SPEDY_ENABLED != true, NENHUMA nota é emitida
# (a integração é um no-op completo). Ative apenas após configurar a empresa
# no backoffice da Spedy e testar no sandbox.
SPEDY_ENABLED=false

# Ambiente: 'sandbox' (testes, isolado) ou 'production'
SPEDY_ENVIRONMENT=sandbox

# Chave de API (X-Api-Key). Use a chave do ambiente correspondente.
# Pode usar SPEDY_API_KEY (fallback) ou as específicas por ambiente.
SPEDY_API_KEY=
SPEDY_API_KEY_SANDBOX=
SPEDY_API_KEY_PRODUCTION=

# ID da empresa na Spedy (opcional — apenas referência/diagnóstico)
SPEDY_COMPANY_ID=

# Token compartilhado para validar o webhook da Spedy (recomendado).
# Configure a mesma string na URL do webhook (?token=... ou header x-spedy-token).
SPEDY_WEBHOOK_TOKEN=

# Enviar e-mail da nota ao cliente automaticamente (default: true)
SPEDY_SEND_EMAIL=true

# Produto usado na nota de EBOOK (Spedy emite só a nota de ebook, só na 1ª compra).
# A tributação/imunidade do livro é configurada no backoffice da Spedy p/ este produto.
SPEDY_EBOOK_PRODUCT_NAME=Ebook
SPEDY_EBOOK_PRODUCT_CODE=ebook

# Timeout das chamadas HTTP à Spedy em ms (default: 45000)
SPEDY_TIMEOUT_MS=45000

# Endereço-padrão (fallback) usado quando o cliente não tem endereço e o
# enriquecimento (losdados) não retornou um. Ajuste para o endereço que você
# quer cadastrar como padrão (ex: endereço da empresa).
SPEDY_FALLBACK_STREET=Praça da Sé
SPEDY_FALLBACK_NUMBER=S/N
SPEDY_FALLBACK_DISTRICT=Sé
SPEDY_FALLBACK_CEP=01001000
SPEDY_FALLBACK_CITY=São Paulo
SPEDY_FALLBACK_STATE=SP
# Opcional: código IBGE do município (se preenchido, usa no lugar de cidade+UF)
SPEDY_FALLBACK_IBGE=
SPEDY_FALLBACK_INFO=Endereço não informado pelo cliente

# ============================================================================
# Enriquecimento fiscal — losdados (CPF/endereço via telefone)
# ----------------------------------------------------------------------------
# USO EXCLUSIVO para emissão de nota fiscal do próprio cliente (LGPD).
# Chave é segredo — não commitar valor real.
LOSDADOS_API_KEY=
# Liga/desliga (default: ligado quando há chave). Use false para desativar.
LOSDADOS_ENABLED=true
# Base da API (padrão já aponta para produção)
LOSDADOS_BASE_URL=https://app.losdados.com.br/api/v1
# Timeout das chamadas em ms (default: 20000)
LOSDADOS_TIMEOUT_MS=20000
# Campanha LTV (WhatsApp/WABA) — teto de segurança de envios por 24h.
# Aquecimento do número: comece baixo (30-50/dia). Default: 50.
LTV_DAILY_LIMIT=50
# Intervalo aleatório entre cada envio LTV (anti-rajada). Default 20000-40000ms (20-40s).
LTV_SEND_MIN_DELAY_MS=20000
LTV_SEND_MAX_DELAY_MS=40000

# ── Segredos (defina em produção — NÃO deixar hardcoded no código) ───────────
# Assinatura do cookie de admin. Gere um forte: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se ausente, o servidor gera um aleatório por boot (desloga admins a cada restart).
ADMIN_COOKIE_SECRET=
# Assinatura dos links curtos de recuperação. Gere igual ao de cima.
RECOVERY_LINK_SECRET=
# Credencial Woovi (Basic auth base64). Sem isto, cobranças Woovi falham.
WOOVI_AUTH=
# Token de verificação do webhook do WhatsApp (Meta). Sem isto, a verificação do webhook rejeita.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Janela de horário do LTV (WhatsApp/WABA) ─────────────────────────────────
# LTV só é enviado entre estas horas (BRT). Fora da janela, não envia (reenvia
# no próximo ciclo, dentro do horário). Default: 8h às 21h.
LTV_SEND_START_HOUR=8
LTV_SEND_END_HOUR=21

# Proxy da MEX10 (SMS) — a API exige IP autorizado na allowlist. Formato:
# http://usuario:senha@host:porta . Sem isto, o SMS sai pelo IP do servidor.
MEX10_PROXY_URL=

# Data de início do SMS de recuperação (15%/30%). Só envia SMS para pedidos
# criados a partir daqui (formato YYYY-MM-DD, início do dia em BRT). Default 2026-07-27.
# Pedidos anteriores recebem o e-mail, mas não o SMS.
ORDER_RECOVERY_SMS_START_DATE=2026-07-27
